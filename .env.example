# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email Service (Resend or MailerLite)
# Choose one service and configure accordingly

# Resend Configuration
RESEND_API_KEY=your_resend_api_key
# Sender address on your verified domain (e.g. noreply@yourdomain.com) — not Gmail
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Replies go to contactEmail in src/lib/site.ts

# Protected admin secret for /api/send-newsletter (generate a long random string)
NEWSLETTER_ADMIN_SECRET=your_long_random_secret

# Sanity CMS (optional — new articles from studio; static articles still work without this)
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production

# Sanity Studio (studio/.env — same project id)
SANITY_STUDIO_PROJECT_ID=your_sanity_project_id
SANITY_STUDIO_DATASET=production

# Google Analytics 4 (optional — Measurement ID from analytics.google.com, e.g. G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# MailerLite Configuration (alternative to Resend)
# MAILERLITE_API_KEY=your_mailerlite_api_key
# MAILERLITE_GROUP_ID=your_mailerlite_group_id
