# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email Service (Resend or MailerLite)
# Choose one service and configure accordingly

# Resend Configuration
RESEND_API_KEY=your_resend_api_key
# Sender address on your verified domain (e.g. noreply@voyaflair.com) — not Gmail
RESEND_FROM_EMAIL=noreply@voyaflair.com
# Replies go to contactEmail in src/lib/site.ts (voyaflair@gmail.com)

# Protected admin secret for /api/send-newsletter (generate a long random string)
NEWSLETTER_ADMIN_SECRET=your_long_random_secret

# MailerLite Configuration (alternative to Resend)
# MAILERLITE_API_KEY=your_mailerlite_api_key
# MAILERLITE_GROUP_ID=your_mailerlite_group_id
