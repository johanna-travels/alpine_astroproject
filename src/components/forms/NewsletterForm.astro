---
interface Props {
  base?: string;
  class?: string;
}

const { base = "", class: className = "" } = Astro.props;
const formId = `newsletter-${crypto.randomUUID().slice(0, 8)}`;
const apiPath = `${import.meta.env.BASE_URL}api/subscribe`.replace(/\/{2,}/g, "/");
---

<form
  id={formId}
  class:list={["flex flex-col gap-4", className]}
  lang="en"
  novalidate
  data-newsletter-form
>
  <div class="flex flex-col sm:flex-row gap-3">
    <div class="flex-1 relative">
      <input
        type="email"
        name="email"
        placeholder="Enter your email"
        required
        class="w-full px-4 py-2.5 placeholder-white/60 bg-[#4a534f] border border-white/30 rounded-md text-white text-sm focus:outline-none focus:ring-2 focus:ring-white/50 focus:border-white/50 transition-all disabled:opacity-50"
        data-newsletter-email
      />
      <p class="text-red-300 text-xs mt-1 hidden" data-newsletter-email-error />
    </div>
    <button
      type="submit"
      class="px-6 py-2.5 text-xs tracking-[0.2em] uppercase bg-[#F4F1EA] text-[#2D2D2D] rounded-md hover:bg-white/90 transition-all duration-300 whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed"
      data-newsletter-submit
    >
      Subscribe
    </button>
  </div>

  <div class="flex items-start gap-3">
    <input
      type="checkbox"
      id={`${formId}-consent`}
      name="consent"
      required
      class="mt-0.5 w-4 h-4 rounded border-white/40 bg-[#4a534f] text-white focus:ring-white/50 cursor-pointer"
      data-newsletter-consent
    />
    <label for={`${formId}-consent`} class="text-xs text-white/90 leading-relaxed cursor-pointer">
      I agree to the{" "}
      <a href={`${base}/privacy-policy`} class="underline hover:text-white/90">Privacy Policy</a>{" "}
      and consent to receive emails.
    </label>
  </div>
  <p class="text-red-300 text-xs ml-7 hidden" data-newsletter-consent-error />

  <p class="text-xs hidden" data-newsletter-message />
</form>

<script define:vars={{ apiPath }}>
  function initNewsletterForms() {
    document.querySelectorAll("[data-newsletter-form]").forEach((form) => {
      if (form.dataset.bound === "true") return;
      form.dataset.bound = "true";

      const emailInput = form.querySelector("[data-newsletter-email]");
      const consentInput = form.querySelector("[data-newsletter-consent]");
      const submitBtn = form.querySelector("[data-newsletter-submit]");
      const emailError = form.querySelector("[data-newsletter-email-error]");
      const consentError = form.querySelector("[data-newsletter-consent-error]");
      const message = form.querySelector("[data-newsletter-message]");

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      const setMessage = (text, type) => {
        if (!message) return;
        message.textContent = text;
        message.classList.remove("hidden", "text-green-300", "text-red-300");
        message.classList.add(type === "success" ? "text-green-300" : "text-red-300");
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const email = emailInput?.value.trim() ?? "";
        const consent = consentInput?.checked ?? false;

        emailError?.classList.add("hidden");
        consentError?.classList.add("hidden");
        message?.classList.add("hidden");

        let valid = true;
        if (!email) {
          if (emailError) {
            emailError.textContent = "Email is required";
            emailError.classList.remove("hidden");
          }
          valid = false;
        } else if (!emailPattern.test(email)) {
          if (emailError) {
            emailError.textContent = "Please enter a valid email address";
            emailError.classList.remove("hidden");
          }
          valid = false;
        }
        if (!consent) {
          if (consentError) {
            consentError.textContent = "You must agree to the privacy policy";
            consentError.classList.remove("hidden");
          }
          valid = false;
        }
        if (!valid) return;

        submitBtn.disabled = true;
        submitBtn.textContent = "Subscribing...";

        try {
          const response = await fetch(apiPath, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, consent }),
          });
          const result = await response.json();

          if (response.ok) {
            setMessage(result.message || "Successfully subscribed!", "success");
            submitBtn.textContent = "Subscribed!";
            form.reset();
          } else {
            setMessage(result.error || "Something went wrong. Please try again.", "error");
            submitBtn.disabled = false;
            submitBtn.textContent = "Subscribe";
          }
        } catch {
          setMessage("Network error. Please try again.", "error");
          submitBtn.disabled = false;
          submitBtn.textContent = "Subscribe";
        }
      });
    });
  }

  initNewsletterForms();
  document.addEventListener("astro:page-load", initNewsletterForms);
</script>
