---
import { apiUrl, pageUrl } from '@/lib/site';

interface Props {
  class?: string;
  variant?: 'footer' | 'banner';
}

const { class: className = '', variant = 'footer' } = Astro.props;
const isBanner = variant === 'banner';
const formId = `newsletter-${crypto.randomUUID().slice(0, 8)}`;
const apiPath = apiUrl('subscribe');

const inputClass = isBanner
  ? 'w-full px-4 py-2.5 placeholder:text-neutral-400 bg-white border border-[#E5DFD4] rounded-md text-neutral-900 text-sm focus:outline-none focus:ring-2 focus:ring-[#69746E]/25 focus:border-[#69746E] transition-all disabled:opacity-50'
  : 'w-full px-4 py-2.5 placeholder-white/60 bg-[#4a534f] border border-white/30 rounded-md text-white text-sm focus:outline-none focus:ring-2 focus:ring-white/50 focus:border-white/50 transition-all disabled:opacity-50';

const submitClass = isBanner
  ? 'px-6 py-2.5 text-sm font-medium tracking-wide bg-[#69746E] text-white rounded-md hover:opacity-80 transition-opacity duration-200 whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed w-full sm:mt-0 sm:w-auto'
  : 'px-6 py-2.5 text-xs tracking-[0.2em] uppercase bg-[#F4F1EA] text-[#2D2D2D] rounded-md hover:bg-white/90 transition-all duration-300 whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed';

const checkboxClass = isBanner
  ? 'mt-0.5 w-4 h-4 rounded border-[#E5DFD4] bg-white text-[#69746E] focus:ring-[#69746E]/30 cursor-pointer'
  : 'mt-0.5 w-4 h-4 rounded border-white/40 bg-[#4a534f] text-white focus:ring-white/50 cursor-pointer';

const labelClass = isBanner
  ? 'text-xs text-black/70 leading-relaxed cursor-pointer'
  : 'text-xs text-white/90 leading-relaxed cursor-pointer';

const linkClass = isBanner
  ? 'underline underline-offset-2 text-[#69746E] hover:text-[#4a534f]'
  : 'underline hover:text-white/90';

const emailErrorClass = isBanner
  ? 'text-red-600 text-xs mt-1 hidden'
  : 'text-red-300 text-xs mt-1 hidden';

const consentErrorClass = isBanner
  ? 'text-red-600 text-xs ml-7 hidden'
  : 'text-red-300 text-xs ml-7 hidden';
---

<form
  id={formId}
  class:list={["flex flex-col gap-4", className]}
  lang="en"
  novalidate
  data-newsletter-form
  data-variant={variant}
>
  <div class="flex flex-col sm:flex-row gap-3">
    <div class="flex-1 relative">
      <input
        type="email"
        name="email"
        autocomplete="email"
        placeholder={isBanner ? 'Enter your email address' : 'Enter your email'}
        required
        class={inputClass}
        data-newsletter-email
      />
      <p class={emailErrorClass} data-newsletter-email-error />
    </div>
    <button
      type="submit"
      class={submitClass}
      data-newsletter-submit
      disabled
    >
      Subscribe
    </button>
  </div>

  <div class="flex items-start gap-3">
    <input
      type="checkbox"
      id={`${formId}-consent`}
      name="consent"
      autocomplete="off"
      required
      class={checkboxClass}
      data-newsletter-consent
    />
    <label for={`${formId}-consent`} class={labelClass}>
      I agree to the{" "}
      <a href={pageUrl('privacy-policy')} class={linkClass}>Privacy Policy</a>{" "}
      and consent to receive emails.
    </label>
  </div>
  <p class={consentErrorClass} data-newsletter-consent-error />

  <p class="text-xs hidden" data-newsletter-message />
</form>

<script define:vars={{ apiPath }}>
  function initNewsletterForms() {
    document.querySelectorAll("[data-newsletter-form]").forEach((form) => {
      if (form.dataset.bound === "true") return;
      form.dataset.bound = "true";

      const emailInput = form.querySelector("[data-newsletter-email]");
      const consentInput = form.querySelector("[data-newsletter-consent]");
      const submitBtn = form.querySelector("[data-newsletter-submit]");
      const emailError = form.querySelector("[data-newsletter-email-error]");
      const consentError = form.querySelector("[data-newsletter-consent-error]");
      const message = form.querySelector("[data-newsletter-message]");

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      const isFormReady = () => {
        const email = emailInput?.value.trim() ?? "";
        const consent = consentInput?.checked ?? false;
        return emailPattern.test(email) && consent;
      };

      const updateSubmitState = () => {
        if (!submitBtn) return;
        if (submitBtn.textContent === "Subscribed!") {
          submitBtn.textContent = "Subscribe";
        }
        submitBtn.disabled = !isFormReady();
      };

      emailInput?.addEventListener("input", updateSubmitState);
      consentInput?.addEventListener("change", updateSubmitState);

      const setMessage = (text, type) => {
        if (!message) return;
        const isBannerForm = form.dataset.variant === "banner";
        message.textContent = text;
        message.classList.remove(
          "hidden",
          "text-green-300",
          "text-red-300",
          "text-emerald-700",
          "text-red-600"
        );
        if (type === "success") {
          message.classList.add(isBannerForm ? "text-emerald-700" : "text-green-300");
        } else {
          message.classList.add(isBannerForm ? "text-red-600" : "text-red-300");
        }
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const email = emailInput?.value.trim() ?? "";
        const consent = consentInput?.checked ?? false;

        emailError?.classList.add("hidden");
        consentError?.classList.add("hidden");
        message?.classList.add("hidden");

        let valid = true;
        if (!email) {
          if (emailError) {
            emailError.textContent = "Email is required";
            emailError.classList.remove("hidden");
          }
          valid = false;
        } else if (!emailPattern.test(email)) {
          if (emailError) {
            emailError.textContent = "Please enter a valid email address";
            emailError.classList.remove("hidden");
          }
          valid = false;
        }
        if (!consent) {
          if (consentError) {
            consentError.textContent = "You must agree to the privacy policy";
            consentError.classList.remove("hidden");
          }
          valid = false;
        }
        if (!valid) return;

        submitBtn.disabled = true;
        submitBtn.textContent = "Subscribing...";

        try {
          const response = await fetch(apiPath, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, consent }),
          });
          const result = await response.json();

          if (response.ok) {
            if (result.emailSent === false && result.detail) {
              console.error("Subscribe API detail:", result.detail);
            }

            const type = result.emailSent === false ? "error" : "success";
            setMessage(result.message || "Something went wrong. Please try again.", type);
            submitBtn.textContent = result.emailSent === false ? "Subscribe" : "Subscribed!";
            submitBtn.disabled = result.emailSent === false;
            if (result.emailSent !== false) form.reset();
            if (result.emailSent !== false) updateSubmitState();
          } else {
            setMessage(result.error || "Something went wrong. Please try again.", "error");
            if (result.detail) {
              console.error("Subscribe API detail:", result.detail);
            }
            submitBtn.disabled = false;
            submitBtn.textContent = "Subscribe";
            updateSubmitState();
          }
        } catch {
          setMessage("Network error. Please try again.", "error");
          submitBtn.textContent = "Subscribe";
          updateSubmitState();
        }
      });

      updateSubmitState();
    });
  }

  initNewsletterForms();
  document.addEventListener("astro:page-load", initNewsletterForms);
</script>
