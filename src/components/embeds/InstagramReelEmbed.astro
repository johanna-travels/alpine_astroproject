---
import type { ImageMetadata } from 'astro:assets';
import { instagramPermalink } from '@/lib/instagram';

interface Props {
  /** Public reel/post URL (Instagram → Share → Copy link). */
  permalink: string;
  title?: string;
  class?: string;
  /** Kept for call-site compatibility; official embed shows Instagram’s own preview. */
  poster?: ImageMetadata;
  posterAlt?: string;
}

const {
  permalink,
  title = 'View this post on Instagram',
  class: className = 'my-6 max-w-md md:my-8',
} = Astro.props;

const cleanPermalink = instagramPermalink(permalink);
---

<figure class:list={[className]} data-instagram-reel-embed>
  <blockquote
    class="instagram-media !m-0 !w-full"
    data-instgrm-captioned
    data-instgrm-permalink={cleanPermalink}
    data-instgrm-version="14"
    style="background:#FFF; border:0; border-radius:12px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin:0; max-width:540px; min-width:326px; padding:0; width:100%;"
  >
    <a href={cleanPermalink} target="_blank" rel="noopener noreferrer">{title}</a>
  </blockquote>
</figure>

<script is:inline>
  (function () {
    const EMBED_SRC = 'https://www.instagram.com/embed.js';

    function processInstagramEmbeds() {
      if (window.instgrm && window.instgrm.Embeds) {
        window.instgrm.Embeds.process();
      }
    }

    function ensureEmbedScript() {
      if (document.querySelector('script[data-instagram-embed-js]')) {
        processInstagramEmbeds();
        return;
      }
      const script = document.createElement('script');
      script.src = EMBED_SRC;
      script.async = true;
      script.dataset.instagramEmbedJs = 'true';
      script.onload = processInstagramEmbeds;
      document.body.appendChild(script);
    }

    ensureEmbedScript();
    document.addEventListener('astro:page-load', ensureEmbedScript);
  })();
</script>
