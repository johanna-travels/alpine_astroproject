---
import ArticlePreviewCard from '@/components/ui/ArticlePreviewCard.astro';
import type { Destination } from '@/domains/destinations/catalog';
import { articlesForDestination, articleHref } from '@/domains/articles/catalog';

interface Props {
  destination: Destination;
}

const { destination } = Astro.props;
const displayArticles = articlesForDestination(destination.slug).map((article) => ({
  href: articleHref(article.slug),
  image: article.image,
  category: article.category,
  title: article.title,
  alt: article.alt,
  comingSoon: article.comingSoon,
}));
---

<main class="min-h-screen bg-white text-neutral-900 px-4 md:px-10 pb-24 pt-12">
  <h1 class="mb-8">{destination.name}</h1>
  <p class="prose-body text-neutral-600 max-w-3xl">{destination.description}</p>

  <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-10 lg:grid-cols-3 md:mt-12">
    {displayArticles.map((article, index) => (
      <ArticlePreviewCard
        {...article}
        priority={index < 3}
        fetchPriority={index === 0 ? 'high' : undefined}
      />
    ))}
  </div>
</main>
