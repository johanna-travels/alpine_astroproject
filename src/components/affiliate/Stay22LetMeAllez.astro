---
import { getStay22LmaId } from '@/lib/stay22';

const lmaId = getStay22LmaId() ?? '';
---

{lmaId && (
  <>
    {/* ID στο HTML, όχι στο script: το define:vars έκανε inline χωρίς hash και το CSP έκοβε το Stay22 (άρα τις προμήθειες). */}
    <meta name="stay22-lma-id" content={lmaId} />
    <script>
      declare global {
        interface Window {
          Stay22?: { params?: { lmaID: string } };
        }
      }

      const lmaId =
        document.querySelector('meta[name="stay22-lma-id"]')?.getAttribute('content') ?? '';

      if (lmaId) {
        window.Stay22 = window.Stay22 || {};
        window.Stay22.params = { lmaID: lmaId };
        const stay22Loader = document.createElement('script');
        stay22Loader.async = true;
        stay22Loader.src = 'https://scripts.stay22.com/letmeallez.js';
        document.head.appendChild(stay22Loader);
      }
    </script>
  </>
)}
