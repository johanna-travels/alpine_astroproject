---
import CtaLink from '@/components/ui/CtaLink.astro';

interface Props {
  title: string;
  href?: string;
  ctaLabel?: string;
}

const { title, href, ctaLabel = 'VIEW ALL' } = Astro.props;
---

<div class="flex flex-row flex-nowrap items-center pt-[30px] pb-[30px] gap-2 w-full lg:pt-[70px] lg:pl-[145px]">
  <div class="w-auto">
    <h2 class="text-black m-0 p-0">{title}</h2>
  </div>
  {href && (
    <div class="flex items-center">
      <CtaLink href={href} label={ctaLabel} />
    </div>
  )}
</div>
