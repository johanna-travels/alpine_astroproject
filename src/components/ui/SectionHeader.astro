---
import CtaLink from '@/components/ui/CtaLink.astro';

interface Props {
  title: string;
  href?: string;
  ctaLabel?: string;
}

const { title, href, ctaLabel = 'VIEW ALL' } = Astro.props;
---

<div class="section-gutter section-header flex w-full min-w-0 flex-row flex-nowrap items-center justify-between gap-2">
  <div class="shrink-0">
    <h2 class="text-black m-0 p-0">{title}</h2>
  </div>
  {href && (
    <div class="flex shrink-0 items-center">
      <CtaLink href={href} label={ctaLabel} class="px-0 md:px-[32px]" />
    </div>
  )}
</div>
