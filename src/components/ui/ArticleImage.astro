---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { articleImageSizes, articleImageWidths } from "@/lib/images";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  imgClass?: string;
  figureClass?: string;
}

const { src, alt, caption, imgClass = "", figureClass = "my-5 md:my-8" } = Astro.props;
---

<figure class={figureClass}>
  <Image
    src={src}
    alt={alt}
    widths={[...articleImageWidths]}
    sizes={articleImageSizes}
    class={`w-full rounded-lg ${imgClass || "h-auto"}`}
    loading="lazy"
    decoding="async"
  />
  {caption && (
    <figcaption class="mt-2 text-center text-xs text-black/40 italic sm:text-sm">
      {caption}
    </figcaption>
  )}
</figure>
