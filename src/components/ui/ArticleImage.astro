---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { articleImageSizes, articleImageWidths } from "@/lib/images";
import { socialIconPaths } from "@/domains/site/social-icons";
import { siteOrigin } from "@/lib/site";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  imgClass?: string;
  figureClass?: string;
  priority?: boolean;
  /** Show Pinterest pin control on hover (default false). */
  pinOnHover?: boolean;
}

const {
  src,
  alt,
  caption,
  imgClass = "",
  figureClass = "my-5 md:my-8",
  priority = false,
  pinOnHover = false,
} = Astro.props;

const pinterestIcon = socialIconPaths.pinterest;

let pinHref: string | undefined;
if (pinOnHover) {
  const pinImage = await getImage({ src, width: 1200, format: "webp", quality: 85 });
  const mediaUrl = new URL(pinImage.src, siteOrigin).href;
  const pageUrl = new URL(`${Astro.url.pathname}${Astro.url.search}`, siteOrigin).href;
  const params = new URLSearchParams({
    url: pageUrl,
    media: mediaUrl,
    description: alt,
  });
  pinHref = `https://www.pinterest.com/pin/create/button/?${params.toString()}`;
}
---

<figure class={figureClass}>
  <div
    class:list={[
      "article-image-pin group relative overflow-hidden rounded-lg",
      pinOnHover && pinHref && "cursor-pointer",
    ]}
  >
    <Image
      src={src}
      alt={alt}
      widths={[...articleImageWidths]}
      sizes={articleImageSizes}
      class:list={["w-full rounded-lg", imgClass || "h-auto"]}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : undefined}
      decoding="async"
    />
    {pinOnHover && pinHref && (
      <a
        href={pinHref}
        class="article-image-pin__button absolute left-3 top-3 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-[#E60023] text-white opacity-0 shadow-md transition-opacity duration-300 ease-out hover:bg-[#ad081b] group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#E60023]"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Pin on Pinterest"
        data-pin-do="buttonPin"
      >
        <svg
          class="h-5 w-5"
          viewBox={pinterestIcon.viewBox}
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={pinterestIcon.path} />
        </svg>
      </a>
    )}
  </div>
  {caption && (
    <figcaption class="mt-2 text-center text-xs text-black/40 italic sm:text-sm">
      {caption}
    </figcaption>
  )}
</figure>
