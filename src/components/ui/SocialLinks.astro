---
import { socialLinks } from '@/domains/site/social';
import { socialIconPaths } from '@/domains/site/social-icons';

interface Props {
  class?: string;
  iconClass?: string;
  linkClass?: string;
}

const {
  class: className = '',
  iconClass = '',
  linkClass = 'text-white/70 hover:text-white transition-colors text-[0.875rem]',
} = Astro.props;
---

<div class:list={['flex items-center gap-5', className]}>
  {socialLinks.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={link.ariaLabel}
      class={linkClass}
    >
      <svg
        viewBox={socialIconPaths[link.icon].viewBox}
        width="20"
        height="20"
        fill="currentColor"
        class={iconClass}
        aria-hidden="true"
      >
        <path d={socialIconPaths[link.icon].path} />
      </svg>
    </a>
  ))}
</div>
