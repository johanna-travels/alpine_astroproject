---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getBentoCellClass, isBentoFeatured } from '@/lib/bento-grid';
import { bentoImageSizes, bentoImageWidths } from '@/lib/images';
import { instagramEmbedSrc } from '@/lib/instagram';

export type BentoMediaItem =
  | {
      kind: 'image';
      src: ImageMetadata;
      alt: string;
      title?: string;
      description?: string;
    }
  | {
      kind: 'video';
      /** Resolved URL from `import clip from '...MP4'` */
      src: string;
      alt: string;
      title?: string;
      poster?: ImageMetadata;
    }
  | {
      kind: 'instagram';
      /** Reel/post URL; when empty, poster image is shown instead */
      permalink?: string;
      poster: ImageMetadata;
      alt: string;
      title?: string;
    };

interface Props {
  items: BentoMediaItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
const visible = items.slice(0, 4);
const count = visible.length;

const videoPosterUrls = new Map<BentoMediaItem, string>();
for (const item of visible) {
  if (item.kind === 'video' && item.poster) {
    const optimized = await getImage({ src: item.poster, width: 900, format: 'webp' });
    videoPosterUrls.set(item, optimized.src);
  }
}

const mediaClass = 'absolute inset-0 z-[1] h-full w-full object-cover object-center';
const videoClass = `${mediaClass} pointer-events-none`;
const overlayClass =
  'absolute inset-x-0 bottom-0 z-[2] bg-gradient-to-t from-black/70 via-black/25 to-transparent p-4';
---

{count > 0 && (
  <div class:list={[className, 'my-5 md:my-8']}>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:auto-rows-fr">
      {visible.map((item, index) => {
        const featured = isBentoFeatured(index, count);
        const cellClass = getBentoCellClass(index, count);
        const title = item.title;

        return (
          <div class={cellClass}>
            {item.kind === 'image' && (
              <>
                <Image
                  src={item.src}
                  alt={item.alt}
                  widths={[...bentoImageWidths]}
                  sizes={bentoImageSizes}
                  class={mediaClass}
                  loading="lazy"
                  decoding="async"
                />
                {title && (
                  <div class={overlayClass}>
                    {featured ? (
                      <h3 class="text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.6)]">{title}</h3>
                    ) : (
                      <h4 class="text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.6)]">{title}</h4>
                    )}
                    {featured && item.description && (
                      <p class="mt-1 text-sm text-white/90 [text-shadow:0_1px_3px_rgba(0,0,0,0.6)]">
                        {item.description}
                      </p>
                    )}
                  </div>
                )}
              </>
            )}

            {item.kind === 'video' && (
              <>
                <video
                  class={videoClass}
                  src={item.src}
                  poster={videoPosterUrls.get(item)}
                  autoplay
                  muted
                  loop
                  playsinline
                  disablepictureinpicture
                  controlslist="nodownload nofullscreen noremoteplayback"
                  aria-label={item.alt}
                >
                </video>
                {title && (
                  <div class={overlayClass}>
                    {featured ? (
                      <h3 class="text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.6)]">{title}</h3>
                    ) : (
                      <h4 class="text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.6)]">{title}</h4>
                    )}
                  </div>
                )}
              </>
            )}

            {item.kind === 'instagram' && (
              <>
                <Image
                  src={item.poster}
                  alt={item.permalink ? '' : item.alt}
                  widths={[...bentoImageWidths]}
                  sizes={bentoImageSizes}
                  class={mediaClass}
                  loading="lazy"
                  decoding="async"
                  aria-hidden={item.permalink ? true : undefined}
                />
                {item.permalink && (
                  <iframe
                    src={instagramEmbedSrc(item.permalink)}
                    title={item.alt}
                    class={`${mediaClass} z-[2] border-0`}
                    loading="lazy"
                    allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                )}
                {title && (
                  <div class={`${overlayClass} pointer-events-none`}>
                    <h4 class="text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.6)]">{title}</h4>
                  </div>
                )}
              </>
            )}
          </div>
        );
      })}
    </div>
  </div>
)}
