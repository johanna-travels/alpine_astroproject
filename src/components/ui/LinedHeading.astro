---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class:list={['flex items-center justify-center gap-4 md:gap-10', className]}>
  <span class="h-px max-w-[320px] flex-1 bg-[#69746E]" aria-hidden="true"></span>
  <h2 class="shrink-0 whitespace-nowrap text-neutral-900">{title}</h2>
  <span class="h-px max-w-[320px] flex-1 bg-[#69746E]" aria-hidden="true"></span>
</div>
