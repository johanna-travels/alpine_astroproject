---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getBentoCellClass, isBentoFeatured } from "@/lib/bento-grid";
import { bentoImageSizes, bentoImageWidths } from "@/lib/images";

export interface BentoItem {
  src: ImageMetadata;
  alt: string;
  title?: string;
  description?: string;
}

interface Props {
  items: BentoItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
const visible = items.slice(0, 4);
const count = visible.length;
---

{count > 0 && (
  <div class:list={[className, "my-5 md:my-8"]}>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:auto-rows-fr">
      {visible.map((item, index) => {
        const featured = isBentoFeatured(index, count);
        return (
          <div class={getBentoCellClass(index, count)}>
            <Image
              src={item.src}
              alt={item.alt}
              widths={[...bentoImageWidths]}
              sizes={bentoImageSizes}
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            {(item.title || item.description) && (
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 via-black/25 to-transparent p-4">
                {item.title && (featured ? (
                  <h3 class="text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.6)]">{item.title}</h3>
                ) : (
                  <h4 class="text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.6)]">{item.title}</h4>
                ))}
                {featured && item.description && (
                  <p class="mt-1 text-sm text-white/90 [text-shadow:0_1px_3px_rgba(0,0,0,0.6)]">{item.description}</p>
                )}
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
)}
