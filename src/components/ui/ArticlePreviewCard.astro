---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  image: ImageMetadata;
  category: string;
  title: string;
  alt: string;
}

const { href, image, category, title, alt } = Astro.props;
---

<a href={href} class="group block">
  <div class="relative aspect-square w-full overflow-hidden rounded-xl">
    <Image
      src={image}
      alt={alt}
      width={800}
      height={800}
      densities={[1, 2]}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent pointer-events-none z-10" />
  </div>
  <div class="pt-4">
    <span class="meta block text-black mb-1">{category}</span>
    <h3 class="text-[#1e1e1e] mb-2">{title}</h3>
    <span class="text-[0.875rem] font-medium text-black inline-flex items-center gap-2 transition-all">
      Read more
      <span class="leading-none transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">→</span>
    </span>
  </div>
</a>
