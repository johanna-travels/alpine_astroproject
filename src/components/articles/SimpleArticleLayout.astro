---
import PageBreadcrumbHero from '@/components/sections/PageBreadcrumbHero.astro';
import CtaLink from '@/components/ui/CtaLink.astro';
import { pageUrl } from '@/lib/site';

interface Props {
  metaLabel: string;
  title: string;
  breadcrumbTitle: string;
  breadcrumbHref: string;
  heroSrc: string;
  lead?: string;
}

const { metaLabel, title, breadcrumbTitle, breadcrumbHref, heroSrc, lead } = Astro.props;
---

<PageBreadcrumbHero
  title={title}
  currentPage={breadcrumbTitle}
  currentHref={breadcrumbHref}
  imageSrc={heroSrc}
/>

<main class="relative z-10 w-full min-h-screen flex flex-col items-center bg-white py-16">
  <article class="w-full max-w-[760px] px-4 md:px-0">
    <p class="meta text-neutral-500 mb-4">{metaLabel}</p>
    <h1 class="mb-8">{title}</h1>

    {lead && (
      <p class="prose-body text-neutral-600 italic border-l-2 border-neutral-200 pl-4 mb-8">
        {lead}
      </p>
    )}

    <slot />

    <CtaLink
      href={pageUrl('destinations')}
      label="← Back to Destinations"
      showArrow={false}
      class="!px-0 !py-0 !normal-case !tracking-normal !text-[13px]"
    />
  </article>
</main>
