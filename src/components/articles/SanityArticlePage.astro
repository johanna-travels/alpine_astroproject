---
import ArticlePage from '@/components/articles/ArticlePage.astro';
import SanityArticleBody from '@/components/articles/SanityArticleBody.astro';
import type { SanityArticle } from '@/lib/sanity/types';
import type { TocGroup } from '@/domains/articles/toc';

interface Props {
  article: SanityArticle;
}

const { article } = Astro.props;

const catalogArticle = {
  slug: article.slug,
  destinationSlug: article.destinationSlug,
  category: article.category,
  title: article.title,
  carouselTitle: article.title,
  breadcrumbTitle: article.title,
  metaLabel: article.category,
  alt: article.heroImageAlt,
  image: { src: article.heroImageUrl, width: 1200, height: 800 },
  publishedDate: article.publishedDate,
  intro: article.intro,
  lead: article.intro[0],
  seoTitle: article.seoTitle,
  seoDescription: article.seoDescription,
};

const sections: TocGroup[] = article.sections.map((section, index) => ({
  navTitle: section.navTitle || `${index + 1}. ${section.heading}`,
  target: section.sectionId,
}));
---

<ArticlePage article={catalogArticle as any} sections={sections}>
  {
    article.sections.map((section) => (
      <section id={section.sectionId} class="scroll-mt-nav">
        <div class="mb-5 max-w-3xl text-black md:mb-6">
          <h3>{section.heading}</h3>
        </div>
        <SanityArticleBody blocks={section.body} />
      </section>
    ))
  }
</ArticlePage>
