import meijiSakeBarrels from '@/assets/articles/tokyo/meiji-jingu-sake-barrels-tokyo.webp';
import meijiSakeBarrelsWide from '@/assets/articles/tokyo/sake-barrels-meiji-jingu-shrine-tokyo.webp';
import takeshitaStreet from '@/assets/articles/tokyo/takeshita-street-harajuku-tokyo.webp';
import sweetBoxCrepes from '@/assets/articles/tokyo/sweet-box-crepes-harajuku-tokyo.webp';
import uniDonuts from '@/assets/articles/tokyo/uni-donuts-harajuku-tokyo.webp';
import shibuyaCrossing from '@/assets/articles/tokyo/shibuya-crossing-view-mags-park-tokyo.webp';
import hachikoStatue from '@/assets/articles/tokyo/shibuya-hachiko-statue-tokyo.webp';
import shibuyaSkyDeck from '@/assets/articles/tokyo/shibuya-sky-observation-deck-tokyo.webp';
import shibuyaSkyView from '@/assets/articles/tokyo/shibuya-sky-tokyo-view.webp';

import kamakuraGoryo from '@/assets/articles/tokyo/kamakura-goryo-shrine.webp';
import kamakuraHasederaEntrance from '@/assets/articles/tokyo/kamakura-hasedera-temple-entrance.webp';
import kamakuraHasederaBamboo from '@/assets/articles/tokyo/kamakura-hasedera-temple-bamboo.webp';
import kamakuraBuddha from '@/assets/articles/tokyo/kamakura-great-buddha-kotokuin.webp';
