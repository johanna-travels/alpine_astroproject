import hieToriiWalk from '@/assets/articles/tokyo/walking-through-hie-shrine-torii-gates-tokyo.webp';
import akasakaHarryPotter from '@/assets/articles/tokyo/akasaka-station-harry-potter-tokyo.webp';
import akasakaOwl from '@/assets/articles/tokyo/akasaka-station-harry-potter-owl-display-tokyo.webp';
