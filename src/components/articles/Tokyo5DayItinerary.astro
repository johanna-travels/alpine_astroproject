import sensojiGate from '@/assets/articles/tokyo/asakusa-sensoji-kaminarimon-gate-tokyo.webp';
import sensojiPagoda from '@/assets/articles/tokyo/asakusa-sensoji-five-story-pagoda-tokyo.webp';
import sensojiNakamise from '@/assets/articles/tokyo/asakusa-sensoji-nakamise-street-early-morning-tokyo.webp';
