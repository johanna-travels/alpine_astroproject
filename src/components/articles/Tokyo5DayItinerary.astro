import shinjukuCat from '@/assets/articles/tokyo/shinjuku-3d-cat-billboard-tokyo.webp';

import teamlabBorderless from '@/assets/articles/tokyo/teamlab-borderless-tokyo.webp';
import teamlabDigitalArt from '@/assets/articles/tokyo/teamlab-borderless-digital-art-tokyo.webp';
