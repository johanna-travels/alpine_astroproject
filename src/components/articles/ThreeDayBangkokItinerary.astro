import iconsiamRiverView from '@/assets/articles/thailand/3-day-bangkok-itinerary-iconsiam-river-view.webp';
import iconsiamWaterfall from '@/assets/articles/thailand/things-to-do-in-bangkok-iconsiam.webp';
import talatNoiMural from '@/assets/articles/thailand/things-to-do-in-bangkok-talat-noi-mural.webp';
