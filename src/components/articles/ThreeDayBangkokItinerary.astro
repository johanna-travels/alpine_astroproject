import naam1608Sunset from '@/assets/articles/thailand/things-to-do-in-bangkok-naam1608-sunset.webp';
import pastelCocktail from '@/assets/articles/thailand/things-to-do-in-bangkok-pastel-cocktail.webp';
import watBenchamabophitAlone from '@/assets/articles/thailand/3-day-bangkok-itinerary-wat-benchamabophit-alone.webp';
import goldenBuddha from '@/assets/articles/thailand/wat-paknam-phasi-charoen-big-buddha-bangkok.webp';
