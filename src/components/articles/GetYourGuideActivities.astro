---
/**
 * GetYourGuide activities embed (multi-tour carousel/list).
 * Place anywhere under GetYourGuideProvider (site-wide in Layout.astro).
 */
import { getYourGuidePartnerId } from '@/lib/getyourguide';

interface Props {
  /** Comma-separated GetYourGuide tour ids (e.g. "123935,456789"). */
  tourIds?: string;
  /** How many activities to show in the widget. */
  numberOfItems?: number;
  partnerId?: string;
  localeCode?: string;
  /** Fallback “Powered by” link (e.g. Bali location page). */
  poweredByHref?: string;
  class?: string;
}

const {
  tourIds = '',
  numberOfItems = 1,
  partnerId: partnerIdProp,
  localeCode = 'en-US',
  poweredByHref = 'https://www.getyourguide.com/',
  class: className = 'my-6 max-w-3xl md:my-8',
} = Astro.props;

const partnerId = partnerIdProp ?? getYourGuidePartnerId();
---

{
  partnerId && (
    <div class={className}>
      <div
        data-gyg-href="https://widget.getyourguide.com/default/activities.frame"
        data-gyg-locale-code={localeCode}
        data-gyg-widget="activities"
        data-gyg-number-of-items={String(numberOfItems)}
        data-gyg-partner-id={partnerId}
        data-gyg-tour-ids={tourIds}
      >
        <span>
          Powered by{' '}
          <a target="_blank" rel="sponsored" href={poweredByHref}>
            GetYourGuide
          </a>
        </span>
      </div>
    </div>
  )
}
