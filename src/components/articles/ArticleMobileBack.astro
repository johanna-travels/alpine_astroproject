---
import { getDestination, destinationHref } from '@/domains/destinations/catalog';
import type { DestinationSlug } from '@/domains/destinations/catalog';
import { pageUrl } from '@/lib/site';

interface Props {
  destinationSlug: DestinationSlug;
}

const { destinationSlug } = Astro.props;
const destination = getDestination(destinationSlug);
const backHref = destination ? destinationHref(destination.slug) : pageUrl('destinations');
const backLabel = destination ? `Back to ${destination.name}` : 'Back to destinations';
---

<a
  href={backHref}
  class="article-mobile-back lg:hidden inline-flex items-center gap-2 mb-5 text-[0.875rem] text-neutral-500 hover:text-neutral-900 transition-colors"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M19 12H5"></path>
    <path d="M12 5l-7 7 7 7"></path>
  </svg>
  {backLabel}
</a>
