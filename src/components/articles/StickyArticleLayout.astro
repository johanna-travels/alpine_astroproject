---
import { flattenTocTargets, type TocGroup } from '@/domains/articles/toc';
import ArticleTocNav from '@/components/articles/ArticleTocNav.astro';

interface Props {
  sections: readonly TocGroup[];
}

const { sections } = Astro.props;
const tocTargets = flattenTocTargets(sections);
---

<div class="article-layout mx-auto w-full max-w-6xl" data-article-toc>
  <div class="article-layout__body">
    <!-- Desktop: slim sticky sidebar -->
    <aside class="article-layout__aside hidden lg:block">
      <div class="article-layout__aside-inner">
        <ArticleTocNav sections={sections} variant="desktop" />
      </div>
    </aside>

    <!-- Main content -->
    <div class="article-layout__main min-w-0">
      {Astro.slots.intro && (
        <header id="section-intro" class="article-layout__intro scroll-mt-nav">
          <slot name="intro" />
        </header>
      )}
      <slot />
    </div>
  </div>
</div>

<style>
  .article-layout__mobile {
    position: static;
    z-index: 30;
    margin-bottom: 1.5rem;
  }

  .article-toc-mobile {
    --box-background-color: rgb(105 116 110);
    position: static;
    height: auto;
    background-color: var(--box-background-color);
    transition: min-height 0.4s ease;
  }

  .article-toc-mobile__header {
    position: static;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 20px;
    background: transparent;
  }

  .article-toc-mobile__title {
    margin: 0;
    margin-right: auto;
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: rgb(255 255 255);
  }

  .article-toc-mobile__toggles {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .article-toc-mobile__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: rgb(255 255 255);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .article-toc-mobile__toggle:hover,
  .article-toc-mobile__toggle:focus-visible {
    background: rgb(255 255 255 / 0.12);
    outline: none;
  }

  .article-toc-mobile__content-wrap {
    position: static;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s ease;
  }

  .article-toc-mobile.is-expanded .article-toc-mobile__content-wrap {
    grid-template-rows: 1fr;
  }

  .article-toc-mobile__content {
    position: static;
    display: block;
    overflow: hidden;
    min-height: 0;
    box-sizing: border-box;
    width: 100%;
    padding: 0;
  }

  .article-toc-mobile.is-expanded .article-toc-mobile__content {
    padding: 20px;
    max-height: var(--toc-body-max-height);
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
  }

  @media (max-width: 767px) {
    .article-toc-mobile__title {
      font-size: 14px;
    }
  }

  .article-layout__body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .article-layout__body {
      flex-direction: row-reverse;
      align-items: flex-start;
      gap: 2.5rem;
    }
  }

  @media (min-width: 1280px) {
    .article-layout__body {
      gap: 3.5rem;
    }
  }

  .article-layout__aside {
    width: var(--toc-width);
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .article-layout__aside {
      position: sticky;
      top: calc(var(--nav-height) + 1.5rem);
      align-self: flex-start;
      z-index: 20;
    }
  }

  .article-layout__aside-inner {
    box-sizing: border-box;
    width: 100%;
    max-height: var(--toc-body-max-height);
    overflow-y: auto;
    overflow-x: hidden;
    padding: 20px;
    scrollbar-width: thin;
    scrollbar-color: rgb(212 212 212) transparent;
  }

  .article-layout__aside-inner::-webkit-scrollbar {
    width: 4px;
  }

  .article-layout__aside-inner::-webkit-scrollbar-thumb {
    background: rgb(212 212 212);
    border-radius: 999px;
  }

  .article-layout__main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .article-layout__main {
      gap: 5rem;
    }
  }

  .article-layout__intro {
    max-width: 48rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgb(245 245 245);
  }

  @media (min-width: 768px) {
    .article-layout__intro {
      padding-bottom: 2.5rem;
    }
  }
</style>

<script define:vars={{ tocTargets }}>
  function initArticleToc() {
    const root = document.querySelector("[data-article-toc]");
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const mobileRoot = root.querySelector("[data-toc-mobile-root]");
    const expandBtn = root.querySelector("[data-toc-expand]");
    const collapseBtn = root.querySelector("[data-toc-collapse]");
    const setPanelOpen = (open) => {
      mobileRoot?.classList.toggle("is-expanded", open);
      expandBtn?.classList.toggle("hidden", open);
      collapseBtn?.classList.toggle("hidden", !open);
      expandBtn?.setAttribute("aria-expanded", String(open));
      collapseBtn?.setAttribute("aria-expanded", String(open));
    };

    const setActive = (targetId) => {
      root.querySelectorAll("[data-toc-target]").forEach((link) => {
        const isActive = link.dataset.tocTarget === targetId;
        link.setAttribute("aria-current", isActive ? "true" : "false");
      });
    };

    root.addEventListener("click", (event) => {
      const link = event.target.closest("[data-toc-target]");
      if (!link) return;

      const targetId = link.dataset.tocTarget;
      if (!targetId) return;

      document.getElementById(targetId)?.scrollIntoView({ behavior: "smooth" });
      setPanelOpen(false);
      setActive(targetId);
    });

    expandBtn?.addEventListener("click", () => setPanelOpen(true));
    collapseBtn?.addEventListener("click", () => setPanelOpen(false));

    const observed = tocTargets
      .map((id) => document.getElementById(id))
      .filter(Boolean);

    if (observed.length === 0) return;

    const pickActiveSection = () => {
      const marker = window.innerHeight * 0.35;
      let activeTarget = observed[0].id;

      for (const section of observed) {
        if (section.getBoundingClientRect().top <= marker) {
          activeTarget = section.id;
        }
      }

      setActive(activeTarget);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible.length === 0) return;
        setActive(visible[0].target.id);
      },
      { rootMargin: "-25% 0px -65% 0px", threshold: 0 }
    );

    observed.forEach((section) => observer.observe(section));
    pickActiveSection();
    window.addEventListener("pageshow", pickActiveSection);
  }

  initArticleToc();
  document.addEventListener("astro:page-load", initArticleToc);
</script>
