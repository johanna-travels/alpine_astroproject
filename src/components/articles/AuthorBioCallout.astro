---
import { Image } from 'astro:assets';
import authorPhoto from '@/assets/marketing/author-joanna.png';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { pageUrl } from '@/lib/site';

interface Props {
  name?: string;
  overline?: string;
  aboutHref?: string;
  readMoreLabel?: string;
  bio?: string;
  class?: string;
}

const {
  name = 'Joanna',
  overline = 'About the Author',
  aboutHref = pageUrl('about'),
  readMoreLabel = 'Read More',
  bio = "Joanna is the creator of Voyaflair — a travel journal shaped by a love of beautiful places, thoughtful planning, and the belief that there is always more to discover. Originally from Greece and now based in Oslo, she has traveled to more than 20 countries and returned to many of them more than once. Here, she shares the places she loves, the details she notices, and the travel tips she wishes someone had shared with her before every trip.",
  class: className = '',
} = Astro.props;
---

<div class:list={['block-area block-area-after-post', className]}>
  <aside id="callout-author-bio" class="callout-author-bio" aria-labelledby="callout-author-bio-title">
    <div class="author-wrap">
      <div class="author-image">
        <Image
          class="round-avatar"
          src={authorPhoto}
          alt={name}
          width={200}
          height={200}
          densities={[1, 2]}
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="author-content">
        <p class="author-overprint">{overline}</p>
        <h2 id="callout-author-bio-title" class="author-title">{name}</h2>

        <div class="author-desc">
          <slot name="bio">
            <p>{bio}</p>
          </slot>
        </div>

        <slot name="actions">
          <a class="block-callout-button" href={aboutHref}>
            <span class="block-callout-button-text">{readMoreLabel}</span>
            <svg width="24" height="24" aria-hidden="true" viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </slot>

        <slot name="social">
          <SocialLinks
            class="social-follow-container"
            linkClass="text-neutral-500 hover:text-neutral-900 transition-colors"
          />
        </slot>
      </div>
    </div>
  </aside>
</div>

<style>
  .block-area-after-post {
    width: 100%;
    margin-top: 4rem;
  }

  @media (min-width: 800px) {
    .block-area-after-post {
      margin-top: 0;
    }
  }

  .callout-author-bio {
    width: 100%;
  }

  .author-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
  }

  /* Mobile-first: stacked, overlapping avatar */
  .author-image {
    position: relative;
    z-index: 10;
    margin-bottom: -60px;
    flex-shrink: 0;
  }

  .author-image :global(.round-avatar) {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #fff;
    display: block;
  }

  .author-content {
    background: #f9f9f9;
    padding: 80px 40px 40px;
    width: 100%;
    border-radius: 8px;
    text-align: center;
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .author-overprint {
    margin: 0;
    font-family: var(--font-logo);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(105 116 110);
  }

  .author-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    font-weight: 600;
    line-height: 1.2;
    color: rgb(23 23 23);
  }

  .author-desc :global(p) {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.8;
    color: rgb(64 64 64);
  }

  @media (min-width: 768px) {
    .author-desc :global(p) {
      font-size: 18px;
    }
  }

  .block-callout-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.35rem 0;
    font-family: var(--font-logo);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(105 116 110);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .block-callout-button:hover,
  .block-callout-button:focus-visible {
    color: rgb(74 83 79);
    outline: none;
  }

  .block-callout-button-text {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .social-follow-container {
    justify-content: center;
    padding-top: 0.25rem;
  }

  @media (max-width: 479px) {
    .author-content {
      padding: 80px 24px 32px;
    }
  }

  /* Desktop: unified card, side-by-side */
  @media (min-width: 800px) {
    .author-wrap {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
      max-width: none;
      background: #f9f9f9;
      border-radius: 8px;
      padding: 2.5rem;
    }

    .author-image {
      margin-bottom: 0;
      z-index: auto;
    }

    .author-image :global(.round-avatar) {
      width: 200px;
      height: 200px;
    }

    .author-content {
      flex: 1;
      min-width: 0;
      background: transparent;
      padding: 0;
      border-radius: 0;
      text-align: left;
      align-items: flex-start;
    }

    .social-follow-container {
      justify-content: flex-start;
    }
  }
</style>
