---
import ArticleClosingNote from '@/components/articles/ArticleClosingNote.astro';
import ArticleImage from '@/components/ui/ArticleImage.astro';
import ArticlePinSaveSection from '@/components/articles/ArticlePinSaveSection.astro';
import ArticleShareBar from '@/components/articles/ArticleShareBar.astro';

import brunchClub from '@/assets/articles/bali/bali-brunch-club-pererenan.webp';
import brunchClubInterior from '@/assets/articles/bali/bali-restaurant-plant-interior-brunch-club.webp';
import brunchClubPancakes from '@/assets/articles/bali/brunch-club-pererenan-fluffy-pancakes.webp';
import blendCafe from '@/assets/articles/bali/bali-ubud-blend-cafe.webp';
import kyndCafe from '@/assets/articles/bali/bali-kynd-comunity-cafe.webp';
import livingstoneCafe from '@/assets/articles/bali/bali-ubud-livingstone-holyground-cafe.webp';
import milkMadu from '@/assets/articles/bali/bali-canggu-milk-madu-beach-road-cafe.webp';
import melaliCafe from '@/assets/articles/bali/bali-ubud-melali-cafe.webp';
import motelMexicola from '@/assets/articles/bali/bali-seminyak-motel-mexicola.webp';
import museCafe from '@/assets/articles/bali/bali-ubud-muse-cafe-art.webp';
import singleFin from '@/assets/articles/bali/bali-uluwatu-single-fin.webp';
import tisCafe from '@/assets/articles/bali/bali-tis-cafe.webp';
import tisCafeBreakfast from '@/assets/articles/bali/bali-tis-cafe-breakfast.webp';
import tisCafeRiceTerraceView from '@/assets/articles/bali/bali-tis-cafe-rice-terrace-view.webp';
import uluwatuFoodSunset from '@/assets/articles/bali/bali-uluwatu-food-sunset-view.webp';
import uluwatuPool from '@/assets/articles/bali/bali-uluwatu-restaurant-pool-evening-vibes.webp';
import wedjaEntrance from '@/assets/articles/bali/ubud-wedja-restaurant-balinese-entrance.webp';
import wedjaWaterGarden from '@/assets/articles/bali/ubud-wedja-water-garden-lotus-path.webp';
import wedjaDining from '@/assets/articles/bali/wedja-restaurant-ubud-dining-experience.webp';
import bestCafesInBaliPin from '@/assets/articles/bali/best-cafes-in-bali-pin.png';

const prose = 'article-prose max-w-3xl text-black/80 [&_p]:mb-5 [&_p:last-child]:mb-0';
const mapLink = 'text-[#69746E] underline underline-offset-2 hover:text-[#4a534f]';
const imageGrid = 'my-5 grid grid-cols-1 items-start gap-3 sm:grid-cols-3 md:my-8 md:gap-4';
const cafeGallery = 'mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 md:mt-10 md:gap-4';

const otherCafes = [
  {
    title: 'Milk & Madu Beach Road (Canggu)',
    description:
      "A popular all-day dining spot with a relaxed atmosphere, generous portions, and consistently good food. It's the kind of place that works equally well for breakfast, lunch, or dinner.",
    image: milkMadu,
    alt: 'Milk & Madu Beach Road café in Canggu, Bali',
    caption: 'Milk & Madu Beach Road',
  },
  {
    title: 'KYND Community (Seminyak, Canggu & Uluwatu)',
    description:
      "One of Bali's most Instagrammable cafés, known for its colorful smoothie bowls, creative presentation, and fully plant-based menu. Fortunately, the food is just as enjoyable as the photos.",
    image: kyndCafe,
    alt: 'KYND Community café in Bali',
    caption: 'KYND Community',
  },
  {
    title: 'Muse Café & Art (Ubud)',
    description:
      'A lovely option for anyone looking for healthier food choices in Ubud. The menu focuses on fresh ingredients, and the atmosphere feels calm and welcoming.',
    image: museCafe,
    alt: 'Muse Café & Art in Ubud, Bali',
    caption: 'Muse Café & Art',
  },
  {
    title: 'Livingstone Holyground (Ubud)',
    description:
      "One of the places I would consider if you're looking for somewhere to work remotely for a few hours. The food is excellent, the space is comfortable, and there's plenty of room to settle in with a laptop.",
    image: livingstoneCafe,
    alt: 'Livingstone Holyground café in Ubud, Bali',
    caption: 'Livingstone Holyground',
  },
  {
    title: 'Motel Mexicola (Seminyak, Canggu)',
    description:
      "If you're craving Mexican food while in Bali, Motel Mexicola is worth considering. I found it a little pricey compared to some other restaurants on the island, but the food certainly didn't disappoint.",
    image: motelMexicola,
    alt: 'Motel Mexicola restaurant in Canggu, Bali',
    caption: 'Motel Mexicola',
  },
  {
    title: 'Melali Ubud (Ubud)',
    description:
      'A great spot for a relaxed meal in Ubud. While the front faces a busy road, the seating area further inside feels much quieter and makes it easy to forget about the traffic outside.',
    image: melaliCafe,
    alt: 'Melali Ubud café in Bali',
    caption: 'Melali Ubud',
  },
] as const;

const otherCafeGallery = otherCafes.flatMap((cafe) =>
  'image' in cafe ? [{ src: cafe.image, alt: cafe.alt, caption: cafe.caption }] : []
);
---

<section id="section-0" class="scroll-mt-nav">
  <div class="mb-5 max-w-3xl text-black md:mb-6">
    <h2 class="text-xl md:text-2xl font-semibold text-neutral-900 mb-4">1. Tis Café (Tegallalang)</h2>
  </div>
  <div class={prose}>
    <p>If you're looking for a breakfast spot with a view, Tis Café is one of the places I remember most from Bali. Located near the rice terraces of Tegallalang, it offers a peaceful setting surrounded by greenery and makes a great place to start the day.</p>
    <div class={imageGrid}>
      <div class="sm:col-span-2">
        <ArticleImage src={tisCafeBreakfast} alt="Breakfast with a view at Tis Café near Tegallalang, Bali" caption="Breakfast with a view at Tis Café" figureClass="m-0" imgClass="aspect-[4/5] object-cover" />
      </div>
      <div class="flex flex-col gap-3 sm:col-span-1 md:gap-4">
        <ArticleImage src={tisCafeRiceTerraceView} alt="Rice terrace view from Tis Café in Tegallalang, Bali" caption="Overlooking the Tegallalang rice terraces" figureClass="m-0" imgClass="aspect-[4/5] object-cover" />
        <ArticleImage src={tisCafe} alt="The peaceful setting at Tis Café in Tegallalang, Bali" caption="The peaceful, greenery-filled setting" figureClass="m-0" imgClass="aspect-[4/5] object-cover" />
      </div>
    </div>
    <p>Before breakfast, I spent some time walking through the nearby Mupu Rice Terrace, which made the whole experience feel even more special. While the food was excellent, it was the combination of the views and the peaceful setting that made Tis Café so memorable.</p>
  </div>
</section>

<section id="section-1" class="scroll-mt-nav">
  <div class="mb-5 max-w-3xl text-black md:mb-6">
    <h2 class="text-xl md:text-2xl font-semibold text-neutral-900 mb-4">2. Wedja Restaurant (Ubud)</h2>
  </div>
  <div class={prose}>
    <p>If I had to choose just one place to revisit in Bali, it would probably be Wedja. The atmosphere alone makes it worth visiting, with traditional Balinese design, lush surroundings, and a setting that feels completely different from most cafés and restaurants on the island.</p>
    <div class={imageGrid}>
      <div class="sm:col-span-2">
        <ArticleImage src={wedjaEntrance} alt="Traditional Balinese entrance at Wedja Restaurant in Ubud, Bali" caption="Wedja's traditional Balinese entrance" figureClass="m-0" imgClass="aspect-[4/5] object-cover" />
      </div>
      <div class="flex flex-col gap-3 sm:col-span-1 md:gap-4">
        <ArticleImage src={wedjaWaterGarden} alt="Water garden and lotus path at Wedja Restaurant in Ubud, Bali" caption="The lotus-lined water garden path" figureClass="m-0" imgClass="aspect-[4/5] object-cover" />
        <ArticleImage src={wedjaDining} alt="Dining experience at Wedja Restaurant in Ubud, Bali" caption="The dining experience at Wedja" figureClass="m-0" imgClass="aspect-[4/5] object-cover" />
      </div>
    </div>
    <p>What secured its place on this list, however, was the food. The duck dish ended up being the best meal I had during my two months in Bali, and it's one of the few meals I still remember long after leaving the island.</p>
  </div>
</section>

<section id="section-2" class="scroll-mt-nav">
  <div class="mb-5 max-w-3xl text-black md:mb-6">
    <h2 class="text-xl md:text-2xl font-semibold text-neutral-900 mb-4">3. Blend Café (Ubud)</h2>
  </div>
  <div class={prose}>
    <p>Despite being located right in the center of Ubud, Blend Café feels surprisingly peaceful once you're inside. It became one of the places I found myself returning to whenever I was in Ubud, whether for breakfast, coffee, or one of their beautifully presented smoothie bowls.</p>
    <ArticleImage src={blendCafe} alt="Blend Café in Ubud, Bali" caption="Blend Café — peaceful even in the heart of Ubud" figureClass="my-5 md:my-8" imgClass="aspect-[5/4] object-cover" />
    <p>The café feels completely removed from the busy streets outside, making it an easy place to spend an hour or two before continuing your day.</p>
    <p>Ubud quickly became one of my favorite areas in Bali, not only because of its cafés and restaurants, but also because of its culture, nature, and unique atmosphere. If you're deciding where to base yourself in Bali, I've shared more details in my <a href="/articles/bali-where-to-stay/" class={mapLink}>Where to Stay in Bali</a> guide.</p>
  </div>
</section>

<section id="section-3" class="scroll-mt-nav">
  <div class="mb-5 max-w-3xl text-black md:mb-6">
    <h2 class="text-xl md:text-2xl font-semibold text-neutral-900 mb-4">4. Single Fin (Uluwatu)</h2>
  </div>
  <div class={prose}>
    <p>One of the things I appreciated most about Single Fin was that I managed to get a table without a reservation — something that isn't always easy at popular sunset spots in Bali. Perched on the cliffs of Uluwatu, it's one of the best places to watch the sunset while overlooking the ocean and the surfers below.</p>
    <div class={imageGrid}>
      <div class="sm:col-span-2">
        <ArticleImage src={singleFin} alt="Single Fin restaurant overlooking the cliffs of Uluwatu, Bali" caption="Single Fin — cliffside views over Uluwatu" figureClass="m-0" imgClass="aspect-[4/5] object-cover" />
      </div>
      <div class="flex flex-col gap-3 sm:col-span-1 md:gap-4">
        <ArticleImage src={uluwatuFoodSunset} alt="Food and sunset views at Single Fin in Uluwatu, Bali" caption="Sunset dinner overlooking the ocean" figureClass="m-0" imgClass="aspect-[4/5] object-cover" />
        <ArticleImage src={uluwatuPool} alt="Pool and evening atmosphere at Single Fin in Uluwatu, Bali" caption="Evening vibes by the pool" figureClass="m-0" imgClass="aspect-[4/5] object-cover" />
      </div>
    </div>
    <p>If I were visiting again, I would arrive earlier, spend some time by the pool, and stay through sunset and dinner.</p>
  </div>
</section>

<section id="section-4" class="scroll-mt-nav">
  <div class="mb-5 max-w-3xl text-black md:mb-6">
    <h2 class="text-xl md:text-2xl font-semibold text-neutral-900 mb-4">5. Brunch Club Pererenan (Pererenan)</h2>
  </div>
  <div class={prose}>
    <p>The fluffy pancakes were the reason I first visited Brunch Club, but they ended up being much bigger than I expected. If I were ordering them again, I would probably choose the smaller stack, especially if you're planning to order anything else.</p>
    <div class={imageGrid}>
      <div class="sm:col-span-2">
        <ArticleImage src={brunchClubPancakes} alt="Fluffy pancakes at Brunch Club Pererenan in Bali" caption="The famous fluffy pancakes" figureClass="m-0" imgClass="aspect-[4/5] object-cover" />
      </div>
      <div class="flex flex-col gap-3 sm:col-span-1 md:gap-4">
        <ArticleImage src={brunchClub} alt="Brunch Club Pererenan in Bali" caption="Brunch Club Pererenan" figureClass="m-0" imgClass="aspect-[4/5] object-cover" />
        <ArticleImage src={brunchClubInterior} alt="Plant-filled interior at Brunch Club Pererenan in Bali" caption="Bright, plant-filled interior" figureClass="m-0" imgClass="aspect-[4/5] object-cover" />
      </div>
    </div>
    <p>Beyond the food, I loved the interior, which is filled with plants and natural details that make the whole space feel bright and welcoming.</p>
  </div>
</section>

<section id="section-5" class="scroll-mt-nav">
  <div class="mb-5 max-w-3xl text-black md:mb-6">
    <h2 class="text-xl md:text-2xl font-semibold text-neutral-900 mb-4">Other Cafés Worth Visiting in Bali</h2>
  </div>
  <div class={prose}>
    <p>While the places above were my personal favorites, there are a few other cafés and restaurants that I also enjoyed during my time in Bali and would happily recommend if you have extra time.</p>
    <div class="mt-6 divide-y divide-neutral-100">
      {
        otherCafes.map((cafe) => (
          <div class="py-5 first:pt-0 last:pb-0">
            <h3 class="mb-2 text-black">{cafe.title}</h3>
            <p class="!mb-0">{cafe.description}</p>
          </div>
        ))
      }
    </div>
  </div>
  <div class={cafeGallery}>
    {
      otherCafeGallery.map((photo) => (
        <ArticleImage
          src={photo.src}
          alt={photo.alt}
          caption={photo.caption}
          figureClass="m-0"
          imgClass="aspect-[4/5] object-cover"
        />
      ))
    }
  </div>
</section>

<section id="section-6" class="scroll-mt-nav">
  <div class={prose}>
    <ArticleClosingNote label="Before you go">
      <p>If I were planning another trip to Bali tomorrow, these are the places I'd add straight back to my list.</p>
      <p>Some earned their place on this list because of the food, others because of the atmosphere, the views, or the overall experience. Either way, they're the spots I would happily revisit and recommend to friends visiting Bali for the first time.</p>
    </ArticleClosingNote>

    <ArticlePinSaveSection>
      <ArticleImage
        src={bestCafesInBaliPin}
        alt="Best cafés in Bali — brunch, coffee and sweet finds"
        figureClass="m-0"
        pinOnHover
      />

      <ArticleShareBar
        title="Best Cafés in Bali After 2 Months on the Island"
        pinImage={bestCafesInBaliPin}
        class="mt-6 md:mt-8"
      />
    </ArticlePinSaveSection>
  </div>
</section>
