---
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { primaryNavLinks } from '@/domains/site/navigation';
import { isActivePath } from '@/lib/site';

const { pathname } = Astro.url;

// Links appear one by one when the menu opens
const linkDelays = [
  'group-has-[:checked]/menu:delay-[180ms]',
  'group-has-[:checked]/menu:delay-[230ms]',
  'group-has-[:checked]/menu:delay-[280ms]',
  'group-has-[:checked]/menu:delay-[330ms]',
  'group-has-[:checked]/menu:delay-[380ms]',
];
---

<div class="group/menu h-20 w-20 shrink-0">
  <!-- Hidden checkbox: remembers if the menu is open -->
  <input id="mobile-menu" type="checkbox" autocomplete="off" aria-label="Navigation menu" class="peer sr-only" />

  <!-- Hamburger -->
  <label for="mobile-menu" class="flex h-20 w-20 cursor-pointer items-center justify-center peer-focus-visible:outline peer-focus-visible:outline-2">
    <svg viewBox="0 0 24 24" stroke="currentColor" stroke-linecap="round" class="h-[33px] w-[33px] opacity-80">
      <path d="M1 5.5h22M1 12h22M1 18.5h22" />
    </svg>
  </label>

  <!-- Menu panel -->
  <div class="invisible fixed inset-0 z-[4000] flex items-center bg-[#F5F2EB] px-[8vw] text-gray-900 opacity-60 [clip-path:circle(0%_at_5%_8%)] transition-[clip-path,opacity,visibility] duration-1000 motion-reduce:transition-none group-has-[:checked]/menu:visible group-has-[:checked]/menu:opacity-100 group-has-[:checked]/menu:[clip-path:circle(150%_at_5%_8%)]">

    <!-- X -->
    <label for="mobile-menu" class="absolute right-4 top-5 flex h-20 w-20 cursor-pointer items-center justify-center transition-transform duration-1000 motion-reduce:transition-none sm:right-6 group-has-[:checked]/menu:rotate-90 group-has-[:checked]/menu:scale-[1.08] group-has-[:checked]/menu:duration-[1000ms]">
      <svg viewBox="0 0 24 24" stroke="currentColor" stroke-linecap="round" class="h-[33px] w-[33px] opacity-80">
        <path d="M4 4l16 16M20 4L4 20" />
      </svg>
    </label>

    <!-- Links -->
    <div class="flex flex-col items-start gap-1">
      {primaryNavLinks.map((link, i) => (
        <a
          href={link.href}
          aria-current={isActivePath(pathname, [link.href, ...(link.match ?? [])]) ? 'page' : undefined}
          class:list={[
            "-translate-x-6 px-2 py-[0.4rem] text-[2.25rem] tracking-[0.02em] opacity-0 transition duration-[240ms] motion-reduce:transition-none aria-[current=page]:font-semibold aria-[current=page]:underline aria-[current=page]:underline-offset-[0.35em] group-has-[:checked]/menu:translate-x-0 group-has-[:checked]/menu:opacity-[.72] aria-[current=page]:group-has-[:checked]/menu:opacity-100",
            linkDelays[i],
          ]}
        >
          {link.label}
        </a>
      ))}

      <SocialLinks
        class="mt-6 pl-2 opacity-0 transition-opacity duration-[240ms] motion-reduce:transition-none group-has-[:checked]/menu:opacity-100 group-has-[:checked]/menu:delay-[530ms]"
        linkClass="opacity-60 transition-opacity hover:opacity-100"
      />
    </div>
  </div>
</div>
