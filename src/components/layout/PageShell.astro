---
import Layout from '@/layouts/Layout.astro';
import PageNav from '@/components/layout/PageNav.astro';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const { title, description, noindex, image, imageAlt, imageWidth, imageHeight } = Astro.props;
---

<Layout
  title={title}
  description={description}
  noindex={noindex}
  image={image}
  imageAlt={imageAlt}
  imageWidth={imageWidth}
  imageHeight={imageHeight}
>
  <Fragment slot="head"><slot name="head" /></Fragment>
  <PageNav />
  <slot />
  <Footer />
</Layout>
