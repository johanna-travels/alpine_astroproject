---
import { HamburgerMenuOverlay } from '@/components/layout/HamburgerMenuOverlay';
import { isActivePath, pageUrl } from '@/lib/site';
import { primaryNavLinks } from '@/domains/site/navigation';
import { socialLinks } from '@/domains/site/social';
import type { SocialIcon } from '@/domains/site/social';

interface Props {
  overlay?: boolean;
}

// 1. Αρχικοποίηση Props & URL
const { overlay = false } = Astro.props;
const { pathname } = Astro.url;
const isHeroOverlayPage = isActivePath(pathname, [pageUrl('services')]);
const isStickyPage = isActivePath(pathname, [pageUrl('about')]);
const overlayNav = overlay || isHeroOverlayPage;

// 2. Δυναμικό Θέμα Χρωμάτων βάσει URL
const getTheme = () => {
  // Overlay nav for /services (dark hero); about uses the default light nav
  if (isHeroOverlayPage) {
    return {
      // Background: Transparent -> Sticky White στο scroll
      nav: "bg-transparent data-[scrolled=true]:bg-white transition-colors duration-300 h-auto min-h-[120px] md:min-h-[140px]",
      
      // Logo: Λευκό -> Μαύρο στο scroll
      logo: "text-white group-data-[scrolled=true]:text-black transition-colors duration-300",
      
      // Mobile Logo Border/Text: Λευκό -> Μαύρο στο scroll
      mobileLogo: "text-white border-white group-data-[scrolled=true]:text-black group-data-[scrolled=true]:border-black transition-colors duration-300",
      
      // Links: Λευκά -> Μαύρα στο scroll
      links: "text-white hover:text-white/80 group-data-[scrolled=true]:text-black group-data-[scrolled=true]:hover:text-gray-700",
      
      // Hamburger Icon (3-bars): Λευκό -> Μαύρο στο scroll
      hamburgerWrapper: "text-white group-data-[scrolled=true]:text-black transition-colors duration-300"
    };
  }

  // Default εμφάνιση για όλες τις υπόλοιπες σελίδες
  return {
    nav: overlay 
      ? "md:bg-transparent md:text-white data-[scrolled=true]:md:bg-white data-[scrolled=true]:md:text-black transition-colors duration-300" 
      : "bg-white text-gray-900",
    logo: overlay 
      ? "text-white group-data-[scrolled=true]:text-black transition-colors duration-300" 
      : "text-[#1a1a1a]",
    mobileLogo: "text-[#1a1a1a] border-gray-500",
    links: overlay 
      ? "text-white/80 hover:text-white group-data-[scrolled=true]:text-gray-600 group-data-[scrolled=true]:hover:text-gray-900" 
      : "text-gray-600 hover:text-gray-900",
    hamburgerWrapper: overlay
      ? "text-white group-data-[scrolled=true]:text-black transition-colors duration-300"
      : "text-black"
  };
};

const theme = getTheme();

interface DropdownSection {
  title: string;
  href?: string;
  showArrow?: boolean;
  countries?: { label: string; href: string }[];
  categories?: { label: string; href: string; count?: number }[];
  products?: { label: string; href: string }[];
}

type NavLink = (typeof primaryNavLinks)[number] & {
  hasDropdown?: boolean;
  dropdownItems?: DropdownSection[];
  variant?: 'nav' | 'social';
  iconType?: SocialIcon;
};

const links: NavLink[] = [
  ...primaryNavLinks.map((link) => ({ ...link, variant: 'nav' as const })),
  ...socialLinks.map((link) => ({
    label: link.label,
    href: link.href,
    variant: 'social' as const,
    iconType: link.icon,
  })),
];

const isActive = (link: NavLink) => isActivePath(pathname, [link.href, ...(link.match ?? [])]);
---

<nav
  id={overlayNav ? "navbar" : undefined}
  data-scrolled="false"
  class:list={[
    "site-nav group w-full px-4 sm:px-6 md:px-10 lg:px-16 xl:px-20",
    theme.nav,
    overlayNav && !isHeroOverlayPage && "site-nav--overlay md:fixed md:inset-x-0 md:top-0 md:z-50",
    isHeroOverlayPage && "site-nav--overlay fixed inset-x-0 top-0 z-50",
    isStickyPage && "sticky top-0 z-50",
  ]}
>
  <div class="w-full md:max-w-[1500px] mx-auto flex items-center justify-between min-h-[120px] md:min-h-[140px] gap-4 md:gap-8">
    
    <!-- Mobile decorative logo -->
   <a 
      href={pageUrl()} 
      data-testid="mobile-logo" 
      class:list={[
        "md:hidden inline-flex items-center justify-center w-12 h-12 rounded-full border border-[1.5px] text-xl sm:text-2xl font-bold tracking-wider",
        theme.mobileLogo
      ]} 
      style="font-family: var(--font-logo);"
    >
      VF
    </a>

    <!-- Desktop simple logo -->
    <a 
      href={pageUrl()} 
      data-testid="desktop-logo" 
      class:list={[
        "hidden md:block text-[calc(1.35rem*0.9)] md:text-[calc(1.6875rem*0.9)] font-normal tracking-wider",
        theme.logo
      ]} 
      style="font-family: var(--font-logo);"
    >
      VOYAFLAIR
    </a>

    <!-- Nav Links (Desktop) -->
    <div class="nav-links hidden md:flex items-center gap-8 font-medium">
      {links.filter(link => link.variant !== 'social').map((link) => (
        <div class="relative group">
          <a
            href={link.href}
            class:list={[
              "site-nav__link relative text-[1.51875rem] flex items-center gap-1 pb-1 transition-colors duration-[450ms] ease-[cubic-bezier(0.4,0,0.2,1)]",
              "after:absolute after:left-0 after:right-0 after:bottom-0 after:h-[2px] after:bg-current after:scale-x-0 after:origin-left after:transition-transform after:duration-[450ms] after:ease-[cubic-bezier(0.4,0,0.2,1)]",
              "hover:after:scale-x-100 aria-[current=page]:after:scale-x-100 [&.is-active]:after:scale-x-100",
              "motion-reduce:transition-none motion-reduce:after:transition-none",
              theme.links,
              isActive(link) && "is-active",
            ]}
            aria-current={isActive(link) ? "page" : undefined}
            aria-haspopup={link.hasDropdown ? "true" : undefined}
            aria-expanded={false}
          >
            {link.label}
            {link.hasDropdown && (
              <svg class="w-4 h-4 transition-transform duration-500 ease-[cubic-bezier(0.4,0,0.2,1)] group-hover:rotate-180" viewBox="0 0 352 512" fill="currentColor">
                <path d="M242.72 256l100.07-100.07c12.28-12.28 12.28-32.19 0-44.48l-22.24-22.24c-12.28-12.28-32.19-12.28-44.48 0L176 189.28l-100.07-100.07c-12.28-12.28-32.19-12.28-44.48 0L9.21 111.45c-12.28 12.28-12.28 32.19 0 44.48L109.28 256 9.21 356.07c-12.28 12.28-12.28 32.19 0 44.48l22.24 22.24c12.28 12.28 32.19 12.28 44.48 0L176 322.72l100.07 100.07c12.28 12.28 32.19 12.28 44.48 0l22.24-22.24c12.28-12.28 12.28-32.19 0-44.48L242.72 256z"/>
              </svg>
            )}
          </a>
          
          {link.hasDropdown && (
            <div class="absolute left-0 top-full mt-2 w-full max-w-[600px] bg-white shadow-xl rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 p-6 text-gray-900">
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {link.dropdownItems?.map((section) => (
                  <div class="col-span-1">
                    {section.title && (
                      <h3 class="font-semibold text-gray-900 mb-3 text-sm">
                        {section.href ? (
                          <a href={section.href} class="hover:text-gray-700 transition-colors flex items-center gap-2">
                            {section.title}
                            {section.showArrow && (
                              <svg class="w-4 h-4" viewBox="0 0 23.268 16.477" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M0 8.239h21.263"/>
                                <path d="M15.151.067c-.18 2.706 1.19 8.117 8.117 8.117"/>
                                <path d="M15.151 16.411c-.18-2.706 1.191-8.117 8.113-8.117"/>
                              </svg>
                            )}
                          </a>
                        ) : (
                          section.title
                        )}
                      </h3>
                    )}
                    
                    {section.countries && (
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        {section.countries.map((country) => (
                          <a href={country.href} class="text-sm text-gray-600 hover:text-gray-900 transition-colors py-1">
                            {country.label}
                          </a>
                        ))}
                      </div>
                    )}
                    
                    {section.categories && (
                      <div class="space-y-2">
                        {section.categories.map((category) => (
                          <a href={category.href} class="flex items-center gap-2 text-sm text-gray-600 hover:text-gray-900 transition-colors py-1">
                            {category.label}
                            {category.count && (
                              <span class="text-xs text-gray-400">({category.count})</span>
                            )}
                          </a>
                        ))}
                      </div>
                    )}
                    
                    {section.products && (
                      <div class="space-y-3">
                        {section.products.map((product) => (
                          <a href={product.href} class="block text-sm text-gray-600 hover:text-gray-900 transition-colors">
                            {product.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Mobile Hamburger Menu Wrapper -->
    <div class:list={["pointer-events-auto flex shrink-0 md:hidden", theme.hamburgerWrapper]}>
      <HamburgerMenuOverlay
        client:load
        activePathname={pathname}
        items={links}
        buttonSize="lg"
        buttonColor="transparent"
        iconColor="currentColor"
        overlayBackground="#F5F2EB"
        textColor="#111827"
        fontSize="xl"
        fontFamily=""
        fontWeight="normal"
        animationDuration={0.6}
        staggerDelay={0.05}
        menuAlignment="left"
        enableBlur={false}
        ariaLabel="Navigation menu"
        zIndex={4000}
      />
    </div>
  </div>
</nav>

{overlayNav && (
  <script>
    window.addEventListener("scroll", function () {
      const navbar = document.getElementById("navbar");
      if (!navbar) return;
      
      if (window.scrollY > 50) {
        navbar.setAttribute("data-scrolled", "true");
      } else {
        navbar.setAttribute("data-scrolled", "false");
      }
    });
  </script>
)}