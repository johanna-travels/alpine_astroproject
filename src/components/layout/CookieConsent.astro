---
import { pageUrl } from '@/lib/site';

interface Props {
  gaMeasurementId?: string;
}

const { gaMeasurementId } = Astro.props;
const cookiePolicyUrl = pageUrl('cookie-policy');
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-gray-200/80 bg-white/95 shadow-[0_-4px_24px_rgb(0_0_0/0.08)] backdrop-blur-sm"
  role="region"
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-description"
  data-testid="cookie-banner"
>
  <div id="cookie-banner-view" class="mx-auto max-w-7xl px-4 py-3 sm:px-6 sm:py-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
      <p id="cookie-banner-description" class="text-xs leading-relaxed text-gray-600 sm:text-sm">
        <span id="cookie-banner-title" class="font-medium text-gray-900">We use cookies</span>
        {' '}to keep the site working and improve your experience. No selling your data.
        <a
          href={cookiePolicyUrl}
          class="ml-1 font-medium text-[#69746E] underline underline-offset-2 hover:text-[#4a534f]"
        >
          Cookie Policy
        </a>
      </p>

      <div class="flex shrink-0 flex-wrap items-center gap-2 sm:gap-2.5">
        <button
          id="cookie-accept-btn"
          type="button"
          class="rounded-full bg-[#69746E] px-4 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-[#4a534f] sm:text-sm"
        >
          Accept
        </button>
        <button
          id="cookie-decline-btn"
          type="button"
          class="rounded-full border border-gray-300 px-4 py-1.5 text-xs font-medium text-gray-600 transition-colors hover:border-gray-400 hover:text-gray-900 sm:text-sm"
        >
          Decline
        </button>
        <button
          id="cookie-manage-btn"
          type="button"
          class="rounded-full px-3 py-1.5 text-xs font-medium text-[#69746E] underline underline-offset-2 transition-colors hover:text-[#4a534f] sm:text-sm"
        >
          Manage
        </button>
      </div>
    </div>
  </div>

  <div id="cookie-preferences-view" class="hidden border-t border-gray-100">
    <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 sm:py-5">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-8">
        <div class="min-w-0 flex-1">
          <p class="text-sm font-semibold text-gray-900">Cookie preferences</p>
          <p class="mt-1 text-xs leading-relaxed text-gray-600 sm:text-sm">
            Essential cookies are always on. Choose whether to allow analytics.
          </p>

          <div class="mt-3 space-y-2">
            <div class="flex items-center justify-between gap-4 rounded-md bg-gray-50 px-3 py-2">
              <span class="text-xs text-gray-700 sm:text-sm">Essential</span>
              <span class="text-[0.65rem] font-medium uppercase tracking-wide text-[#69746E] sm:text-xs">Always on</span>
            </div>

            <label class="flex cursor-pointer items-center justify-between gap-4 rounded-md border border-gray-200 px-3 py-2 transition-colors hover:border-[#69746E]/30">
              <span class="text-xs text-gray-700 sm:text-sm">Analytics</span>
              <input
                id="cookie-analytics-toggle"
                type="checkbox"
                class="h-4 w-4 rounded border-gray-300 text-[#69746E] focus:ring-[#69746E]"
              />
            </label>
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-2 sm:pt-1">
          <button
            id="cookie-save-btn"
            type="button"
            class="rounded-full bg-[#69746E] px-4 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-[#4a534f] sm:text-sm"
          >
            Save
          </button>
          <button
            id="cookie-back-btn"
            type="button"
            class="rounded-full px-3 py-1.5 text-xs font-medium text-gray-500 transition-colors hover:text-gray-800 sm:text-sm"
          >
            Back
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ gaMeasurementId }}>
  const CONSENT_KEY = 'voyaflair_cookie_consent';
  const PREFERENCES_KEY = 'voyaflair_cookie_preferences';
  const CONSENT_ACCEPTED = 'accepted';
  const CONSENT_DECLINED = 'declined';
  const CONSENT_CUSTOM = 'custom';

  function getBanner() {
    return document.getElementById('cookie-banner');
  }

  function getBannerView() {
    return document.getElementById('cookie-banner-view');
  }

  function getPreferencesView() {
    return document.getElementById('cookie-preferences-view');
  }

  function getAnalyticsToggle() {
    return document.getElementById('cookie-analytics-toggle');
  }

  function readPreferences() {
    try {
      const raw = localStorage.getItem(PREFERENCES_KEY);
      if (!raw) return { analytics: false };
      const parsed = JSON.parse(raw);
      return { analytics: Boolean(parsed.analytics) };
    } catch {
      return { analytics: false };
    }
  }

  function writeChoice(status, preferences) {
    try {
      localStorage.setItem(CONSENT_KEY, status);
      localStorage.setItem(PREFERENCES_KEY, JSON.stringify(preferences));
    } catch {
      // Storage blocked — still hide the banner for this session.
    }
  }

  function hasStoredChoice() {
    try {
      const status = localStorage.getItem(CONSENT_KEY);
      return status === CONSENT_ACCEPTED || status === CONSENT_DECLINED || status === CONSENT_CUSTOM;
    } catch {
      return false;
    }
  }

  function hasAnalyticsConsent() {
    try {
      const status = localStorage.getItem(CONSENT_KEY);
      if (status === CONSENT_ACCEPTED) return true;
      if (status === CONSENT_DECLINED) return false;
      if (status === CONSENT_CUSTOM) return readPreferences().analytics;
      return false;
    } catch {
      return false;
    }
  }

  function showBannerView() {
    getBannerView()?.classList.remove('hidden');
    getPreferencesView()?.classList.add('hidden');
  }

  function showPreferencesView() {
    const toggle = getAnalyticsToggle();
    if (toggle) toggle.checked = readPreferences().analytics;
    getBannerView()?.classList.add('hidden');
    getPreferencesView()?.classList.remove('hidden');
    getAnalyticsToggle()?.focus();
  }

  function showBanner(preferencesOnly = false) {
    const banner = getBanner();
    if (!banner) return;
    banner.classList.remove('hidden');
    if (preferencesOnly) {
      showPreferencesView();
    } else {
      showBannerView();
    }
  }

  function hideBanner() {
    const banner = getBanner();
    if (!banner) return;
    banner.classList.add('hidden');
    showBannerView();
  }

  function applyConsent() {
    if (hasAnalyticsConsent()) {
      loadGoogleAnalytics();
    }
  }

  function acceptConsent() {
    writeChoice(CONSENT_ACCEPTED, { analytics: true });
    hideBanner();
    loadGoogleAnalytics();
  }

  function declineConsent() {
    writeChoice(CONSENT_DECLINED, { analytics: false });
    hideBanner();
  }

  function savePreferences() {
    const analytics = Boolean(getAnalyticsToggle()?.checked);
    writeChoice(CONSENT_CUSTOM, { analytics });
    hideBanner();
    if (analytics) {
      loadGoogleAnalytics();
    }
  }

  function loadGoogleAnalytics() {
    if (!gaMeasurementId || window.__voyaflairGaLoaded) return;

    window.__voyaflairGaLoaded = true;
    window.dataLayer = window.dataLayer || [];
    window.gtag =
      window.gtag ||
      function gtag() {
        window.dataLayer.push(arguments);
      };

    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`;
    script.onload = () => {
      window.gtag('js', new Date());
      window.gtag('config', gaMeasurementId, { anonymize_ip: true });
    };
    document.head.appendChild(script);
  }

  function initCookieConsent() {
    const banner = getBanner();
    const acceptBtn = document.getElementById('cookie-accept-btn');
    const declineBtn = document.getElementById('cookie-decline-btn');
    const manageBtn = document.getElementById('cookie-manage-btn');
    const saveBtn = document.getElementById('cookie-save-btn');
    const backBtn = document.getElementById('cookie-back-btn');

    if (!banner || !acceptBtn || banner.dataset.bound === 'true') return;

    banner.dataset.bound = 'true';

    acceptBtn.addEventListener('click', acceptConsent);
    declineBtn?.addEventListener('click', declineConsent);
    manageBtn?.addEventListener('click', showPreferencesView);
    saveBtn?.addEventListener('click', savePreferences);
    backBtn?.addEventListener('click', showBannerView);

    document.addEventListener('voyaflair:open-cookie-preferences', () => {
      showBanner(true);
    });

    if (hasStoredChoice()) {
      hideBanner();
      applyConsent();
      return;
    }

    showBanner();
  }

  initCookieConsent();
</script>
