---
import { pageUrl } from '@/lib/site';

interface Props {
  title: string;
  currentPage: string;
  currentHref: string;
  imageSrc: string;
  desktopImageSrc?: string;
  imageSrcSet?: string;
  imageSizes?: string;
  imageClass?: string;
  imageAlt: string;
}

const {
  title,
  currentPage,
  currentHref,
  imageSrc,
  desktopImageSrc = imageSrc,
  imageSrcSet,
  imageSizes = '(max-width: 768px) 100vw, (max-width: 1280px) 90vw, 1300px',
  imageClass = 'object-center',
  imageAlt,
} = Astro.props;

const mobileImageClass = imageClass.replace(/\blg:\S+/g, '').trim() || 'object-center';
const desktopBgPosition = imageClass.includes('lg:object-right')
  ? 'right center'
  : imageClass.includes('lg:object-left')
    ? 'left center'
    : imageClass.includes('object-right') && !imageClass.includes('lg:object-center')
      ? 'right center'
      : imageClass.includes('object-left') && !imageClass.includes('lg:object-center')
        ? 'left center'
        : 'center';
---

<!-- Mobile & tablet: scrolling img -->
<div class="page-breadcrumb-hero relative mx-[10px] flex min-h-[300px] h-[50vw] max-h-[500px] flex-col justify-end overflow-hidden rounded-[30px] lg:hidden">
  <img
    src={imageSrc}
    srcset={imageSrcSet}
    sizes={imageSizes}
    alt={imageAlt}
    fetchpriority="high"
    decoding="async"
    class:list={['absolute inset-0 h-full w-full object-cover', mobileImageClass]}
  />
  <div class="pointer-events-none absolute inset-0 z-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
  <div class="relative z-10 flex h-full w-full flex-col justify-end">
    <div class="w-full max-w-[1300px] pl-4 pr-4 pb-6 text-white md:pl-6 md:pr-6 md:pb-8">
      <h1 class="hero-title mb-4 text-white">{title}</h1>
      <nav class="flex items-center gap-2 text-sm font-medium text-white/70">
        <a href={pageUrl()} class="text-[0.875rem] transition-colors hover:text-white">Home</a>
        <span class="text-white/50">/</span>
        <a href={currentHref} class="text-[0.875rem] text-white transition-colors hover:text-white/90">{currentPage}</a>
      </nav>
    </div>
  </div>
</div>

<!-- Desktop: fixed bg so scroll layers slide over (matches homepage hero) -->
<div
  class="page-breadcrumb-hero contact-hero relative mx-[10px] hidden aspect-[21/9] max-h-[710px] flex-col justify-end overflow-hidden rounded-[30px] bg-fixed bg-no-repeat lg:flex"
  style={`background-image: url('${desktopImageSrc}'); background-size: cover; background-position: ${desktopBgPosition};`}
>
  <div class="pointer-events-none absolute inset-0 z-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
  <div class="relative z-10 flex h-full w-full flex-col justify-end">
    <div class="w-full max-w-[1300px] pl-4 pr-4 pb-6 text-white md:pl-6 md:pr-6 lg:pl-16 lg:pr-16 xl:pl-20 xl:pr-20 lg:pb-12">
      <h1 class="hero-title mb-4 text-white">{title}</h1>
      <nav class="flex items-center gap-2 text-sm font-medium text-white/70">
        <a href={pageUrl()} class="text-[0.875rem] transition-colors hover:text-white">Home</a>
        <span class="text-white/50">/</span>
        <a href={currentHref} class="text-[0.875rem] text-white transition-colors hover:text-white/90">{currentPage}</a>
      </nav>
    </div>
  </div>
</div>
