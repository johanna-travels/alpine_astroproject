---
import { pageUrl } from '@/lib/site';

interface Props {
  title: string;
  currentPage: string;
  currentHref: string;
  imageSrc: string;
  imageSrcSet?: string;
  imageSizes?: string;
  imageClass?: string;
}

const {
  title,
  currentPage,
  currentHref,
  imageSrc,
  imageSrcSet,
  imageSizes = '(max-width: 768px) 100vw, (max-width: 1280px) 90vw, 1300px',
  imageClass = 'object-center',
} = Astro.props;
---

<div class="relative mx-2 min-h-[300px] h-[50vw] max-h-[500px] rounded-[30px] overflow-hidden">
  <img
    src={imageSrc}
    srcset={imageSrcSet}
    sizes={imageSizes}
    alt=""
    fetchpriority="high"
    decoding="async"
    class:list={['absolute inset-0 h-full w-full object-cover', imageClass]}
    aria-hidden="true"
  />
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
  <div class="relative z-10 flex h-full w-full flex-col justify-end">
    <div class="w-full max-w-[1300px] pl-4 pr-4 pb-6 text-white md:pl-10 md:pr-10 md:pb-8 lg:pl-16 lg:pr-16 lg:pb-12">
      <h1 class="hero-title mb-4 text-white">{title}</h1>
      <nav class="flex items-center gap-2 text-sm font-medium text-white/70">
        <a href={pageUrl()} class="text-[0.875rem] transition-colors hover:text-white">Home</a>
        <span class="text-white/50">/</span>
        <a href={currentHref} class="text-[0.875rem] text-white transition-colors hover:text-white/90">{currentPage}</a>
      </nav>
    </div>
  </div>
</div>
