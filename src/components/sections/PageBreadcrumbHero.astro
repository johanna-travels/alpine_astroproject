---
import PageHero from '@/components/sections/PageHero.astro';
import { pageUrl } from '@/lib/site';

interface Props {
  title: string;
  currentPage: string;
  currentHref: string;
  imageSrc: string;
  desktopImageSrc?: string;
  imageSrcSet?: string;
  imageSizes?: string;
  imageClass?: string;
  imageAlt: string;
}

const {
  title,
  currentPage,
  currentHref,
  imageSrc,
  desktopImageSrc,
  imageSrcSet,
  imageSizes,
  imageClass = 'object-center',
  imageAlt,
} = Astro.props;
---

<PageHero
  title={title}
  imageSrc={imageSrc}
  desktopImageSrc={desktopImageSrc}
  imageSrcSet={imageSrcSet}
  imageSizes={imageSizes}
  imageClass={imageClass}
  imageAlt={imageAlt}
>
  <nav class="flex items-center gap-2 text-sm font-medium text-white/70">
    <a href={pageUrl()} class="text-[0.875rem] transition-colors hover:text-white">Home</a>
    <span class="text-white/50">/</span>
    <a href={currentHref} class="text-[0.875rem] text-white transition-colors hover:text-white/90">{currentPage}</a>
  </nav>
</PageHero>
