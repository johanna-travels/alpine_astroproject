---
export interface SeasonCard {
  title: string;
  subtitle: string;
  description: string;
  imageSrc: string;
  imageSrcSet?: string;
  imageSizes?: string;
  imageAlt?: string;
  href?: string;
}

interface Props {
  cards: SeasonCard[];
  class?: string;
}

const { cards, class: className = "" } = Astro.props;
---

<div class:list={["flex flex-wrap md:flex-nowrap gap-4 w-full px-4", className]}>
  {cards.map((card) => (
    <a
      href={card.href}
      class="group relative flex flex-col justify-end p-6 w-full md:w-1/3 h-[350px] lg:h-[450px] rounded-lg overflow-hidden shadow-lg transition-all duration-700 ease-out lg:hover:w-2/3 cursor-pointer"
    >
      <img
        src={card.imageSrc}
        srcset={card.imageSrcSet}
        sizes={card.imageSizes}
        class="absolute inset-0 w-full h-full object-cover object-center"
        alt={card.imageAlt || card.title}
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent pointer-events-none z-0" />
      <div class="relative md:absolute md:bottom-20 z-10 space-y-2">
        <h2 class="text-white">{card.title}</h2>
        <p class="text-sm text-gray-300">{card.subtitle}</p>
      </div>
      <div class="mt-4 transform translate-y-6 opacity-0 transition-all duration-700 ease-out group-hover:opacity-100 group-hover:translate-y-0">
        <p class="text-lg text-white">{card.description}</p>
      </div>
    </a>
  ))}
</div>
