---
import { Image } from 'astro:assets';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { articles, articleHref } from '@/domains/articles/catalog';
import { pageUrl } from '@/lib/site';

const carouselArticles = articles
  .filter((article) => article.slug !== 'katsuoji-temple-from-osaka' && article.slug !== 'osaka-1-day-itinerary' && article.slug !== 'bali-belly' && article.slug !== 'bali-travel-tips' && article.slug !== 'hong-kong-first-trip');

const cards = [
  ...carouselArticles.filter((article) => article.slug === 'bruges-guide'),
  ...carouselArticles.filter((article) => article.slug === 'rhodes-itinerary'),
  ...carouselArticles.filter((article) => article.slug !== 'bruges-guide' && article.slug !== 'rhodes-itinerary'),
]
  .map((article) => ({
  category: article.category,
  title: article.carouselTitle,
  href: articleHref(article.slug),
  image: article.image,
  alt: article.alt,
}));
---

<SectionHeader title="Articles" href={pageUrl('destinations')} />

<div class="section-gutter relative overflow-hidden">
    <div class="pb-dot-zone">
    <div id="carousel" class="scroll-wrapper">
      {cards.map((card) => (
        <article class="slide" data-slide>
          <a href={card.href} class="slide-link group block" draggable={false}>
            <div class="slide-media relative">
              <Image
                src={card.image}
                alt={card.alt}
                width={400}
                height={400}
                widths={[320, 400, 640]}
                sizes="(min-width: 768px) 33vw, 100vw"
                class="slide-image absolute inset-0"
                loading="lazy"
                draggable={false}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent pointer-events-none z-10" />
            </div>

            <div class="pt-4 px-1">
              <span class="meta block text-black mb-1">{card.category}</span>
              <h3 class="text-[#1e1e1e] mb-2 group-hover:underline group-active:underline underline-offset-4 decoration-1">{card.title}</h3>
              <span class="text-[0.875rem] font-medium text-black inline-flex items-center gap-2">
                Read more
                <span class="leading-none transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">→</span>
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
    </div>

    <div
      role="tablist"
      aria-label="Carousel pagination"
      data-carousel-dots
      data-carousel-id="carousel"
      data-carousel-count={cards.length}
      data-carousel-gap="12"
      class="absolute bottom-[calc(8px)] left-1/2 flex -translate-x-1/2 items-center"
    >
      {cards.map((_, index) => (
        <button
          type="button"
          role="tab"
          aria-label={`Go to slide ${index + 1}`}
          data-carousel-dot={index}
          class="flex h-[30px] cursor-pointer items-center justify-center border-0 bg-transparent px-[9px]"
        >
          <span
            data-carousel-dot-indicator
            class="block h-[6px] w-[6px] rounded-full bg-black/20 transition-colors duration-300"
          />
        </button>
      ))}
    </div>
</div>

<script>
  function initPlayStoreCarousel() {
    const carousel = document.getElementById('carousel') as HTMLDivElement | null;
    const dotsRoot = document.querySelector('[data-carousel-dots]') as HTMLElement | null;

    if (!carousel || carousel.dataset.bound === 'true') return;
    carousel.dataset.bound = 'true';

    const gap = Number(dotsRoot?.getAttribute('data-carousel-gap') ?? 12);
    const slides = carousel.querySelectorAll<HTMLElement>('[data-slide]');
    const dots = dotsRoot?.querySelectorAll('[data-carousel-dot]') ?? [];

    let rafId = 0;
    let isPointerDown = false;
    let didDrag = false;
    let isMouseDrag = false;
    let startX = 0;
    let startScrollLeft = 0;

    const getStep = () => {
      const slide = slides[0];
      return slide ? slide.clientWidth + gap : 300;
    };

    const setDotActive = (index: number) => {
      dots.forEach((dot) => {
        const i = Number(dot.getAttribute('data-carousel-dot'));
        const indicator = dot.querySelector('[data-carousel-dot-indicator]');
        const active = i === index;
        dot.setAttribute('aria-selected', String(active));
        indicator?.classList.toggle('bg-black', active);
        indicator?.classList.toggle('bg-black/20', !active);
      });
    };

    const updateActiveSlide = () => {
      if (!slides.length) return;

      const carouselRect = carousel.getBoundingClientRect();
      const center = carouselRect.left + carouselRect.width / 2;

      let closest = slides[0];
      let closestDistance = Number.POSITIVE_INFINITY;

      slides.forEach((slide) => {
        const rect = slide.getBoundingClientRect();
        const slideCenter = rect.left + rect.width / 2;
        const distance = Math.abs(center - slideCenter);
        if (distance < closestDistance) {
          closestDistance = distance;
          closest = slide;
        }
      });

      slides.forEach((slide) => slide.classList.toggle('is-active', slide === closest));

      const index = Array.from(slides).indexOf(closest);
      if (index >= 0) setDotActive(index);
    };

    const onScroll = () => {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(updateActiveSlide);
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.getAttribute('data-carousel-dot'));
        carousel.scrollTo({ left: index * getStep(), behavior: 'smooth' });
      });
    });

    carousel.addEventListener('scroll', onScroll, { passive: true });

    carousel.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;

      isPointerDown = true;
      didDrag = false;
      isMouseDrag = event.pointerType === 'mouse';
      startX = event.clientX;
      startScrollLeft = carousel.scrollLeft;

      window.addEventListener('pointermove', onPointerMove);
      window.addEventListener('pointerup', onPointerUp);
      window.addEventListener('pointercancel', onPointerUp);
    });

    const onPointerMove = (event: PointerEvent) => {
      if (!isPointerDown) return;

      const deltaX = event.clientX - startX;
      if (Math.abs(deltaX) > 4) {
        didDrag = true;
        if (isMouseDrag) {
          carousel.classList.add('is-dragging');
          carousel.scrollLeft = startScrollLeft - deltaX;
        }
      }
    };

    const onPointerUp = () => {
      isPointerDown = false;
      isMouseDrag = false;
      carousel.classList.remove('is-dragging');
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('pointerup', onPointerUp);
      window.removeEventListener('pointercancel', onPointerUp);
    };

    carousel.addEventListener('click', (event) => {
      if (didDrag) {
        event.preventDefault();
        event.stopPropagation();
      }
    }, true);

    carousel.addEventListener('dragstart', (event) => event.preventDefault());

    updateActiveSlide();
  }

  document.addEventListener('DOMContentLoaded', initPlayStoreCarousel);
  document.addEventListener('astro:page-load', initPlayStoreCarousel);
</script>

<style>
  .scroll-wrapper {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    gap: 12px;
    scrollbar-width: none;
  }

  .scroll-wrapper.is-dragging {
    cursor: grabbing;
  }

  .scroll-wrapper.is-dragging .slide-link {
    pointer-events: none;
  }

  /* Hide scrollbar for Chrome, Safari and Opera */
  .scroll-wrapper::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    max-width: 100%;
    user-select: none;
  }

  .slide-link {
    -webkit-user-drag: none;
    user-select: none;
  }

  .slide-media {
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 100%;
  }

  .slide-media :global(.slide-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .slide {
      flex: 0 0 33.333%; /* Show 3 slides on desktop */
    }
  }
</style>