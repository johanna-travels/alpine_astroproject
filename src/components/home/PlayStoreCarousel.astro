---
import { Image } from 'astro:assets';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { articles, articleHref } from '@/domains/articles/catalog';
import { pageUrl } from '@/lib/site';

// Homepage carousel: only these articles, in this order.
const carouselSlugs = [
  'things-to-do-in-edinburgh',
  'bruges-guide',
  'tokyo-5-day-itinerary',
  'bali-cafes',
  'christmas-in-paris',
  'bruges-christmas-markets',
] as const;

const cards = carouselSlugs
  .map((slug) => articles.find((article) => article.slug === slug))
  .filter((article): article is (typeof articles)[number] => Boolean(article && article.image && !article.comingSoon))
  .map((article) => ({
  category: article.category,
  title: article.carouselTitle,
  href: articleHref(article.slug),
  image: article.image,
  alt: article.alt,
}));
---

<SectionHeader title="Articles" href={pageUrl('destinations')} />

<div class="section-gutter relative overflow-hidden">
    <div class="pb-dot-zone">
    <div id="carousel" class="scroll-wrapper">
      {cards.map((card) => (
        <article class="slide" data-slide>
          <a href={card.href} class="slide-link group block" draggable={false}>
            <div class="slide-media relative">
              <Image
                src={card.image}
                alt={card.alt}
                width={317}
                height={423}
                widths={[215, 317, 430, 634]}
                sizes="(min-width: 768px) 317px, 215px"
                class="slide-image absolute inset-0"
                loading="lazy"
                draggable={false}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent pointer-events-none z-10" />
            </div>

            <div class="pt-4 px-1">
              <span class="meta block text-black mb-1">{card.category}</span>
              <h3 class="text-[#1e1e1e] mb-2 group-hover:underline group-active:underline underline-offset-4 decoration-1">{card.title}</h3>
              <span class="text-[0.875rem] font-medium text-black inline-flex items-center gap-2">
                Read more
                <span class="leading-none transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">→</span>
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
    </div>

    <div
      role="tablist"
      aria-label="Carousel pagination"
      data-carousel-dots
      data-carousel-id="carousel"
      data-carousel-count={cards.length}
      data-carousel-gap="12"
      class="absolute bottom-[calc(8px)] left-1/2 flex -translate-x-1/2 items-center"
    >
      {cards.map((_, index) => (
        <button
          type="button"
          role="tab"
          aria-label={`Go to slide ${index + 1}`}
          data-carousel-dot={index}
          class="flex h-[30px] cursor-pointer items-center justify-center border-0 bg-transparent px-[9px]"
        >
          <span
            data-carousel-dot-indicator
            class="block h-[6px] w-[6px] rounded-full bg-black/20 transition-colors duration-300"
          />
        </button>
      ))}
    </div>
</div>

<script>
  import { initCarousels } from '@/components/carousel/initCarousels';

  document.addEventListener('DOMContentLoaded', initCarousels);
  document.addEventListener('astro:page-load', initCarousels);
</script>

<style>
  .scroll-wrapper {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    gap: 12px;
    scrollbar-width: none;
  }

  .scroll-wrapper.is-dragging {
    cursor: grabbing;
  }

  .scroll-wrapper.is-dragging .slide-link {
    pointer-events: none;
  }

  /* Hide scrollbar for Chrome, Safari and Opera */
  .scroll-wrapper::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 215px;
    max-width: 100%;
    user-select: none;
  }

  .slide-link {
    -webkit-user-drag: none;
    user-select: none;
  }

  .slide-media {
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 215 / 287;
    width: 100%;
    max-width: 100%;
  }

  .slide-media :global(.slide-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .slide {
      flex-basis: 317px;
    }

    .slide-media {
      aspect-ratio: 317 / 423;
    }
  }
</style>