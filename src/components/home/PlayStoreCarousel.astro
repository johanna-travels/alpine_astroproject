---
import { Image } from 'astro:assets';
import articleKyoto from '@/assets/articles/Article Kyoto.webp';
import articleBali from '@/assets/articles/Article Bali.webp';
import articleGreece from '@/assets/articles/Article Greece.webp';
import articleBruges from '@/assets/articles/Article Bruges.webp';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const cards = [
  {
    category: "JAPAN",
    title: "Kyoto 5-Day Itinerary",
    href: `${base}/articles/kyoto-itinerary`,
    image: articleKyoto,
    alt: "Kyoto travel guide",
  },
  {
    category: "BALI",
    title: "My Favorite Cafés in Bali",
    href: `${base}/articles/bali-cafes`,
    image: articleBali,
    alt: "Bali cafés guide",
  },
  {
    category: "GREECE",
    title: "Rhodes 5-Day Itinerary: Beaches, Day Trips & Best Local Food",
    href: `${base}/articles/rhodes-itinerary`,
    image: articleGreece,
    alt: "Rhodes travel guide",
  },
  {
    category: "BELGIUM",
    title: "Bruges Travel guide: Top Attractions and hidden gems",
    href: `${base}/articles/bruges-guide`,
    image: articleBruges,
    alt: "Bruges travel guide",
  }
];
---

<div class="carousel-container w-full">

  <!-- Outer Container (uid: 388) -->
<div class="flex flex-row flex-nowrap items-center pt-[30px] pb-[30px] gap-2 w-full lg:pt-[70px] lg:pl-[145px]">
  
  <!-- Heading Section (uid: 389) -->
  <div class="w-auto">
    <h2 class="text-black m-0 p-0">Articles</h2>
  </div>

  <!-- Button Wrapper (uid: 390/1166) -->
  <div class="flex items-center">
    <a href={`${base}/destinations`} class="inline-block px-[32px] py-[5px] text-black text-[13px] font-medium  uppercase tracking-widest leading-none transition-all opacity-75 transition-opacity duration-300 hover:opacity-100">
      <span class="flex items-center">
        VIEW ALL 
        <span class="ml-2">→</span>
      </span>
    </a>
  </div>

</div>
  <!-- <h1 class="text-3xl font-bold text-center text-gray-800 mb-8">Latest Articles</h1> -->

  <div class="relative lg:ml-[120px] lg:mb-[50px]">
    <!-- Padding wrapper: spacing lives here so utility classes always apply -->
    <div class="pt-carousel-top-sm pb-dot-zone md:pt-carousel-top-md md:px-[40px] lg:pt-carousel-top-lg">
    <div id="carousel" class="scroll-wrapper">
      {cards.map((card) => (
        <a href={card.href} class="slide group block">
          {/* Image block */}
          <div class="slide-media relative">
            <Image
                src={card.image}
                alt={card.alt}
                width={400}
                height={400}
                widths={[320, 400, 640]}
                sizes="(min-width: 768px) 33vw, 100vw"
                densities={[1, 2]}
                class="slide-image absolute inset-0 transition-opacity duration-300"
                loading="lazy"
                draggable={false}
              />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent pointer-events-none z-10"></div>

            {/* Vignette Shadow Overlay */}
            {/* <div class="absolute inset-0 bg-gradient-to-r from-white/10 to-white/30 transition-opacity duration-500 group-hover:opacity-0 pointer-events-none" /> */}
          </div>

          {/* Text + link below the image */}
          <div class="pt-4 px-1 animate-[fadeInUp_0.6s_ease-out]">
            <span class="meta block text-black mb-1">{card.category}</span>
            <h3 class="text-[#1e1e1e] mb-2 group-hover:underline group-active:underline underline-offset-4 decoration-1">{card.title}</h3>
            <span class="text-[0.875rem] font-medium text-black inline-flex items-center gap-2 transition-all">
              Read more
              <span class="leading-none transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
    </div>

    <div
      role="tablist"
      aria-label="Carousel pagination"
      data-carousel-dots
      data-carousel-id="carousel"
      data-carousel-count={cards.length}
      data-carousel-gap="12"
      class="absolute bottom-[calc(8px)] left-1/2 flex -translate-x-1/2 items-center"
    >
      {cards.map((_, index) => (
        <button
          type="button"
          role="tab"
          aria-label={`Go to slide ${index + 1}`}
          data-carousel-dot={index}
          class="flex h-[30px] cursor-pointer items-center justify-center border-0 bg-transparent px-[9px]"
        >
          <span
            data-carousel-dot-indicator
            class="block h-[6px] w-[6px] rounded-full bg-black/20 transition-colors duration-300"
          />
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  function initPlayStoreCarousel() {
    const carousel = document.getElementById('carousel') as HTMLDivElement | null;
    const dotsRoot = document.querySelector('[data-carousel-dots]') as HTMLElement | null;

    if (!carousel || carousel.dataset.bound === 'true') return;
    carousel.dataset.bound = 'true';

    const gap = Number(dotsRoot?.getAttribute('data-carousel-gap') ?? 12);
    const slides = carousel.querySelectorAll<HTMLElement>('.slide');
    const dots = dotsRoot?.querySelectorAll('[data-carousel-dot]') ?? [];

    let scrollInterval: ReturnType<typeof setInterval> | undefined;
    let resumeTimeout: ReturnType<typeof setTimeout> | undefined;
    let rafId = 0;
    let pointerStartX = 0;
    let pointerStartY = 0;
    let isDragging = false;

    const getStep = () => {
      const slide = slides[0];
      return slide ? slide.clientWidth + gap : 300;
    };

    const setDotActive = (index: number) => {
      dots.forEach((dot) => {
        const i = Number(dot.getAttribute('data-carousel-dot'));
        const indicator = dot.querySelector('[data-carousel-dot-indicator]');
        const active = i === index;
        dot.setAttribute('aria-selected', String(active));
        indicator?.classList.toggle('bg-black', active);
        indicator?.classList.toggle('bg-black/20', !active);
      });
    };

    const updateActiveSlide = () => {
      if (!slides.length) return;

      const carouselRect = carousel.getBoundingClientRect();
      const center = carouselRect.left + carouselRect.width / 2;

      let closest = slides[0];
      let closestDistance = Number.POSITIVE_INFINITY;

      slides.forEach((slide) => {
        const rect = slide.getBoundingClientRect();
        const slideCenter = rect.left + rect.width / 2;
        const distance = Math.abs(center - slideCenter);
        if (distance < closestDistance) {
          closestDistance = distance;
          closest = slide;
        }
      });

      slides.forEach((slide) => slide.classList.toggle('is-active', slide === closest));

      const index = Array.from(slides).indexOf(closest);
      if (index >= 0) setDotActive(index);
    };

    const onScroll = () => {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(updateActiveSlide);
    };

    const stopAutoPlay = () => {
      if (scrollInterval) {
        clearInterval(scrollInterval);
        scrollInterval = undefined;
      }
      if (resumeTimeout) {
        clearTimeout(resumeTimeout);
        resumeTimeout = undefined;
      }
    };

    const scrollToNext = () => {
      const step = getStep();
      const maxScrollLeft = carousel.scrollWidth - carousel.clientWidth;

      if (carousel.scrollLeft >= maxScrollLeft - 5) {
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        carousel.scrollBy({ left: step, behavior: 'smooth' });
      }
    };

    const startAutoPlay = () => {
      stopAutoPlay();
      scrollInterval = setInterval(scrollToNext, 3500);
    };

    const pauseAutoPlay = (resumeAfterMs = 5000) => {
      stopAutoPlay();
      resumeTimeout = setTimeout(startAutoPlay, resumeAfterMs);
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.getAttribute('data-carousel-dot'));
        pauseAutoPlay(8000);
        carousel.scrollTo({ left: index * getStep(), behavior: 'smooth' });
      });
    });

    carousel.addEventListener('scroll', onScroll, { passive: true });

    carousel.addEventListener('pointerdown', (event) => {
      pointerStartX = event.clientX;
      pointerStartY = event.clientY;
      isDragging = false;
      pauseAutoPlay();
    });

    carousel.addEventListener('pointermove', (event) => {
      const deltaX = Math.abs(event.clientX - pointerStartX);
      const deltaY = Math.abs(event.clientY - pointerStartY);
      if (deltaX > 6 && deltaX > deltaY) {
        isDragging = true;
        carousel.classList.add('is-dragging');
      }
    });

    carousel.addEventListener('pointerup', () => {
      carousel.classList.remove('is-dragging');
      if (isDragging) pauseAutoPlay();
      isDragging = false;
    });

    carousel.addEventListener('pointercancel', () => {
      carousel.classList.remove('is-dragging');
      isDragging = false;
      pauseAutoPlay();
    });

    carousel.addEventListener('click', (event) => {
      if (isDragging) {
        event.preventDefault();
        event.stopPropagation();
      }
    }, true);

    carousel.addEventListener('wheel', () => pauseAutoPlay(), { passive: true });
    carousel.addEventListener('mouseenter', stopAutoPlay);
    carousel.addEventListener('mouseleave', () => pauseAutoPlay(2000));

    updateActiveSlide();
    startAutoPlay();
  }

  document.addEventListener('DOMContentLoaded', initPlayStoreCarousel);
  document.addEventListener('astro:page-load', initPlayStoreCarousel);
</script>

<style>
  .carousel-container {
    width: 100%;
    overflow: hidden; /* Clips the scrollbar if desired */
    padding: 10px; /* Section: 10px all sides -> 324px content on a 344px viewport */
    margin-bottom: 20px; /* Section: 20px bottom margin */
  }

  .scroll-wrapper {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    scroll-behavior: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    gap: 12px;
    scrollbar-width: none;
    cursor: grab;
    touch-action: pan-x;
  }

  .scroll-wrapper.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  /* Hide scrollbar for Chrome, Safari and Opera */
  .scroll-wrapper::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    max-width: 100%;
    scroll-snap-align: center;
    scroll-snap-stop: normal;
    user-select: none;
    -webkit-user-drag: none;
  }

  .slide-media {
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 100%;
  }

  .slide-media :global(.slide-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    pointer-events: none;
  }

  .slide.is-active .slide-media :global(.slide-image) {
    transform: scale(1);
  }

  @media (min-width: 768px) {
    .slide {
      flex: 0 0 33.333%; /* Show 3 slides on desktop */
    }
  }
</style>