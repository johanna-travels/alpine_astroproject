---
import '../styles/global.css';
import CinematicBody from '../components/layout/CinematicBody.astro';
import { homeUrl } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Voyaflair — Travel Journal',
  description = 'Curated travel guides, beautiful stays, and stories worth remembering — by Joanna.',
  noindex = false,
} = Astro.props;

const isDev = import.meta.env.DEV;
const fb = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? homeUrl).href;
const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "img-src 'self' data: blob:",
  "media-src 'self' blob:",
  "font-src 'self' data:",
  "style-src 'self' 'unsafe-inline'",
  `script-src 'self' 'unsafe-inline'${isDev ? " 'unsafe-eval'" : ""}`,
  `connect-src 'self'${isDev ? " ws://localhost:* wss://localhost:*" : ""}`,
  "form-action 'self'",
  "upgrade-insecure-requests",
].join('; ');

const permissionsPolicy = [
  "camera=()",
  "microphone=()",
  "geolocation=()",
  "payment=()",
  "usb=()",
  "fullscreen=(self)",
].join(', ');

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content={permissionsPolicy} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#69746E" />
    <link rel="preload" href={`${fb}fonts/scheherazade/ScheherazadeNew-Regular.ttf`} as="font" type="font/ttf" crossorigin />
    <Fragment set:html={`<style>
      @font-face {
        font-family: 'ScheherazadeNew';
        src: url('${fb}fonts/scheherazade/ScheherazadeNew-Regular.ttf') format('truetype');
        font-weight: 400; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'ScheherazadeNew';
        src: url('${fb}fonts/scheherazade/ScheherazadeNew-Medium.ttf') format('truetype');
        font-weight: 500; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'ScheherazadeNew';
        src: url('${fb}fonts/scheherazade/ScheherazadeNew-SemiBold.ttf') format('truetype');
        font-weight: 600; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'ScheherazadeNew';
        src: url('${fb}fonts/scheherazade/ScheherazadeNew-Bold.ttf') format('truetype');
        font-weight: 700; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'DoulosSIL';
        src: url('${fb}fonts/doulos/DoulosSIL-Regular.ttf') format('truetype');
        font-weight: 400; font-style: normal; font-display: swap;
      }
    </style>`} />
    <slot name="head" />
  </head>
  <body>
    <CinematicBody />
    <slot />
  </body>
</html>
