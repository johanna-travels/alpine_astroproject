---
import '../styles/global.css';
import CinematicBody from '../components/layout/CinematicBody.astro';
import GoogleAnalytics from '../components/analytics/GoogleAnalytics.astro';
import { googleAnalyticsCsp, getGaMeasurementId, isGoogleAnalyticsEnabled } from '@/lib/analytics';
import { homeUrl } from '@/lib/site';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Voyaflair — Travel Journal',
  description = 'Curated travel guides, beautiful stays, and stories worth remembering — by Joanna.',
  noindex = false,
} = Astro.props;

const isDev = import.meta.env.DEV;
const fb = import.meta.env.BASE_URL;
const gaMeasurementId = getGaMeasurementId();
const googleAnalyticsEnabled = isGoogleAnalyticsEnabled();
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? homeUrl).href;
const logoUrl = new URL(`${fb}icon-512.png`, Astro.site ?? homeUrl).href;
const organizationSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Voyaflair',
  url: homeUrl,
  logo: logoUrl,
});

const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  `img-src 'self' data: blob:${googleAnalyticsEnabled ? ` ${googleAnalyticsCsp.imgSrc}` : ''}`,
  "media-src 'self' blob:",
  "font-src 'self' data:",
  "style-src 'self' 'unsafe-inline'",
  `script-src 'self' 'unsafe-inline'${isDev ? " 'unsafe-eval'" : ''}${googleAnalyticsEnabled ? ` ${googleAnalyticsCsp.scriptSrc}` : ''}`,
  `connect-src 'self'${isDev ? " ws://localhost:* wss://localhost:*" : ''}${googleAnalyticsEnabled ? ` ${googleAnalyticsCsp.connectSrc}` : ''}`,
  "form-action 'self'",
  "upgrade-insecure-requests",
].join('; ');

const permissionsPolicy = [
  "camera=()",
  "microphone=()",
  "geolocation=()",
  "payment=()",
  "usb=()",
  "fullscreen=(self)",
].join(', ');

---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="icYMHuGBR9GDv3N7DZD8dzaDuw9CatrWoh4R9iYcLF4" />
    {googleAnalyticsEnabled && gaMeasurementId && (
      <GoogleAnalytics measurementId={gaMeasurementId} />
    )}
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content={permissionsPolicy} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={logoUrl} />
    <meta property="og:image:alt" content="Voyaflair logo — VF monogram" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={logoUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#69746E" />
    <link rel="icon" type="image/png" sizes="96x96" href={`${fb}favicon-96x96.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${fb}favicon-48x48.png`} />
    <link rel="icon" href={`${fb}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${fb}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${fb}favicon-16x16.png`} />
    <link rel="icon" href={`${fb}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href={`${fb}apple-touch-icon.png`} />
    <link rel="manifest" href={`${fb}site.webmanifest`} />
    <script type="application/ld+json" set:html={organizationSchema} />
    <link rel="preload" href={`${fb}fonts/scheherazade/ScheherazadeNew-Regular.ttf`} as="font" type="font/ttf" crossorigin />
    <Fragment set:html={`<style>
      @font-face {
        font-family: 'ScheherazadeNew';
        src: url('${fb}fonts/scheherazade/ScheherazadeNew-Regular.ttf') format('truetype');
        font-weight: 400; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'ScheherazadeNew';
        src: url('${fb}fonts/scheherazade/ScheherazadeNew-Medium.ttf') format('truetype');
        font-weight: 500; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'ScheherazadeNew';
        src: url('${fb}fonts/scheherazade/ScheherazadeNew-SemiBold.ttf') format('truetype');
        font-weight: 600; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'ScheherazadeNew';
        src: url('${fb}fonts/scheherazade/ScheherazadeNew-Bold.ttf') format('truetype');
        font-weight: 700; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'DoulosSIL';
        src: url('${fb}fonts/doulos/DoulosSIL-Regular.ttf') format('truetype');
        font-weight: 400; font-style: normal; font-display: swap;
      }
    </style>`} />
    <slot name="head" />
  </head>
  <body>
    <CinematicBody />
    <slot />
  </body>
</html>
