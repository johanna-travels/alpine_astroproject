---
import PageShell from '@/components/layout/PageShell.astro';
import PageBreadcrumbHero from '@/components/sections/PageBreadcrumbHero.astro';
import ContactSectionWithShader from '@/components/sections/contact-section-with-shader.tsx';
import { getImage } from 'astro:assets';
import heroImg from '@/assets/heroes/contac-img.webp';
import { getResponsiveHero, heroImageSizes } from '@/lib/images';
import { pageUrl } from '@/lib/site';

const hero = await getResponsiveHero(heroImg);
---

<PageShell title="Contact — Voyaflair">
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={hero.src}
      imagesrcset={hero.srcSet}
      imagesizes={heroImageSizes}
      fetchpriority="high"
    />
  </Fragment>

  <PageBreadcrumbHero
    title="Contact"
    currentPage="Contact"
    currentHref={pageUrl('contact')}
    imageSrc={hero.src}
    desktopImageSrc={hero.largeSrc}
    imageSrcSet={hero.srcSet}
    imageSizes={hero.sizes}
  />

  <ContactSectionWithShader client:idle showImage={false} className="relative z-10 mt-10 bg-white" />
</PageShell>
