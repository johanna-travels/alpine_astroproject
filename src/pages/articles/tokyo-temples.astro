---
import ArticlePage from '@/components/articles/ArticlePage.astro';
import TokyoTemplesContent from '@/components/articles/TokyoTemples.astro';
import JapanBeforeFooter from '@/components/articles/JapanBeforeFooter.astro';
import { tokyoTemplesNav } from '@/domains/articles/tokyo-temples-nav';
import { getArticle } from '@/domains/articles/catalog';
import ArticleImage from '@/components/ui/ArticleImage.astro';
import tokyoTemplesHero from '@/assets/articles/tokyo/tokyo-5-day-itinerary.webp';

const article = getArticle('tokyo-temples')!;
---

<ArticlePage article={article} sections={tokyoTemplesNav}>
  <ArticleImage
    slot="title-media"
    src={tokyoTemplesHero}
    alt="Five-story pagoda at Sensō-ji Temple in Asakusa, Tokyo"
    caption="Sensō-ji pagoda, Asakusa"
    imgClass="aspect-[5/4] object-cover"
    figureClass="mb-6 max-w-3xl md:mb-8"
  />
  <TokyoTemplesContent />
  <JapanBeforeFooter slot="before-footer" currentSlug={article.slug} />
</ArticlePage>
