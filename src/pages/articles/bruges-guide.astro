---
import ArticleGoogleMap from '@/components/articles/ArticleGoogleMap.astro';
import ArticlePage from '@/components/articles/ArticlePage.astro';
import BrugesGuideContent from '@/components/articles/BrugesGuide.astro';
import { brugesNav } from '@/domains/articles/bruges-nav';
import { getArticle } from '@/domains/articles/catalog';

const article = getArticle('bruges-guide')!;
---

<ArticlePage article={article} sections={brugesNav}>
  <ArticleGoogleMap
    title="Google Map of Bruges"
    description="Here's a Google Map with all the locations mentioned in this Bruges guide, plus a few extra spots to help you plan your visit."
    mapId="1iAQBn9oFqf07nux65Qzy7vn0s028Mb8"
  />
  <BrugesGuideContent />
</ArticlePage>
