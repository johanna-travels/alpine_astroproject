---
import ArticlePage from '@/components/articles/ArticlePage.astro';
import ArticleGoogleMap from '@/components/articles/ArticleGoogleMap.astro';
import RhodesGuide from '@/components/articles/RhodesGuide.astro';
import { rhodesNav } from '@/domains/articles/rhodes-nav';
import { getArticle } from '@/domains/articles/catalog';
import { buildArticleLcpSrcSet } from '@/lib/images';

const article = getArticle('rhodes-itinerary')!;
const lcpImageSrcSet = article.lcpImage ? await buildArticleLcpSrcSet(article.lcpImage) : undefined;
---

<ArticlePage article={article} sections={rhodesNav} lcpImageSrcSet={lcpImageSrcSet}>
  <ArticleGoogleMap
    title="Google Map of Rhodes"
    description="Here's a Google Map with all the locations mentioned in this Rhodes guide, plus a few extra spots to help you plan your trip."
    mapId="1YFXsWDA2ndUArdMJWw_RF-Dce4kqDV4"
  />
  <RhodesGuide />
</ArticlePage>
