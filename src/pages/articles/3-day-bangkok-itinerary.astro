---
import ArticlePage from '@/components/articles/ArticlePage.astro';
import { getArticle } from '@/domains/articles/catalog';
import ArticleImage from '@/components/ui/ArticleImage.astro';
import ThreeDayBangkokItinerary from '@/components/articles/ThreeDayBangkokItinerary.astro';
import ThailandBeforeFooter from '@/components/articles/ThailandBeforeFooter.astro';
import threeDayBangkokHero from '@/assets/articles/thailand/things-to-do-in-bangkok-wat-benchamabophit.webp';
import { threeDayBangkokItineraryNav } from '@/domains/articles/three-day-bangkok-itinerary-nav';

const article = getArticle('3-day-bangkok-itinerary')!;
---

<ArticlePage article={article} sections={threeDayBangkokItineraryNav}>
  <figure slot="title-media">
    <ArticleImage
      src={threeDayBangkokHero}
      alt="A woman standing before the ornate marble entrance of Wat Benchamabophit in Bangkok"
      caption="Wat Benchamabophit, the Marble Temple"
      imgClass="aspect-[5/4] object-cover"
      priority
    />
  </figure>
  <aside
    slot="intro-media"
    class="mt-6 max-w-3xl rounded-lg bg-[#F5F2EB] px-4 py-3 text-md leading-relaxed text-black/80"
  >
    <span class="font-medium text-black">💡 Pro Tip:</span> Before your trip, I'd recommend setting up an eSIM so you'll have internet access as soon as you arrive. I use <a href="https://airalo.pxf.io/c/7435210/1268485/15608" target="_blank" rel="noopener noreferrer sponsored" class="text-[#69746E] underline underline-offset-2 hover:text-[#4a534f]">Airalo</a> whenever I travel abroad, and having mobile data made it easy to look up directions, get around the city, and navigate Bangkok from the moment I landed.
  </aside>
  <ThreeDayBangkokItinerary />
  <ThailandBeforeFooter slot="before-footer" currentSlug={article.slug} />
</ArticlePage>
