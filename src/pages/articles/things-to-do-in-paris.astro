---
import ArticlePage from '@/components/articles/ArticlePage.astro';
import { getArticle, articleHref } from '@/domains/articles/catalog';
import ArticleImage from '@/components/ui/ArticleImage.astro';
import ArticlePreviewCard from '@/components/ui/ArticlePreviewCard.astro';
import ParisThingsToDoGuide from '@/components/articles/ParisThingsToDoGuide.astro';
import parisPalaisRoyalHero from '@/assets/articles/paris/things-to-do-in-paris-palais-royal-hero.webp';
import { parisThingsToDoNav } from '@/domains/articles/paris-things-to-do-nav';

const article = getArticle('things-to-do-in-paris')!;
const christmasInParis = getArticle('christmas-in-paris')!;
---

<ArticlePage article={article} sections={parisThingsToDoNav}>
  <figure slot="title-media">
    <ArticleImage
      src={parisPalaisRoyalHero}
      alt="The fountain and gardens of the Jardin du Palais Royal in Paris"
      caption="Jardin du Palais Royal"
      imgClass="aspect-[5/4] object-cover"
      priority
    />
  </figure>
  <aside
    slot="intro-media"
    class="mt-6 max-w-3xl rounded-lg bg-[#F5F2EB] px-4 py-3 text-md leading-relaxed text-black/80"
  >
    <span class="font-medium text-black">💡 Pro Tip:</span> Before your trip, I'd recommend setting up an eSIM so you'll have internet access as soon as you arrive. I use <a href="https://airalo.pxf.io/c/7435210/1268485/15608" target="_blank" rel="noopener noreferrer sponsored" class="text-[#69746E] underline underline-offset-2 hover:text-[#4a534f]">Airalo</a> whenever I travel abroad, and having mobile data made it easy to look up directions, get around the city, and navigate Paris from the moment I landed.
  </aside>
  <ParisThingsToDoGuide />
  <section slot="before-footer" class="mx-auto w-full max-w-6xl px-4 md:pr-10 md:pl-0 pb-16 md:pb-20">
    <h2 class="mb-8 md:mb-10">You may also like</h2>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-10 lg:grid-cols-3">
      <ArticlePreviewCard
        href={articleHref(christmasInParis.slug)}
        image={christmasInParis.image}
        category={christmasInParis.category}
        title={christmasInParis.title}
        alt={christmasInParis.alt}
        comingSoon={christmasInParis.comingSoon}
      />
    </div>
  </section>
</ArticlePage>
