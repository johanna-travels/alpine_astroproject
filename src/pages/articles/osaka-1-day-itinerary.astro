---
import ArticlePage from '@/components/articles/ArticlePage.astro';
import OsakaItineraryContent from '@/components/articles/OsakaItinerary.astro';
import JapanBeforeFooter from '@/components/articles/JapanBeforeFooter.astro';
import { osakaItineraryNav } from '@/domains/articles/osaka-itinerary-nav';
import { getArticle } from '@/domains/articles/catalog';
import ArticleImage from '@/components/ui/ArticleImage.astro';
import experienceOsaka from '@/assets/articles/osaka/experience-the-best-of-osaka-in-a-single-day.webp';

const article = getArticle('osaka-1-day-itinerary')!;
---

<ArticlePage article={article} sections={osakaItineraryNav}>
  <figure slot="title-media">
    <ArticleImage src={experienceOsaka} alt="Experience the best of Osaka in a single day" caption="Experience the best of Osaka in a single day" imgClass="aspect-[5/4] object-cover" />
  </figure>
  <aside
    slot="intro-media"
    class="mt-6 max-w-3xl rounded-lg bg-[#F5F2EB] px-4 py-3 text-md leading-relaxed text-black/80"
  >
    <span class="font-medium text-black">💡 Pro Tip:</span> Before your trip, I'd recommend setting up an eSIM so you'll have internet access as soon as you arrive. I use <a href="https://www.airalo.com/" target="_blank" rel="noopener noreferrer" class="text-[#69746E] underline underline-offset-2 hover:text-[#4a534f]">Airalo</a> whenever I travel abroad, and having mobile data made it easy to access this map, use Google Maps, and navigate the city from the moment I landed.
  </aside>
  <OsakaItineraryContent />
  <JapanBeforeFooter slot="before-footer" currentSlug={article.slug} />
</ArticlePage>
