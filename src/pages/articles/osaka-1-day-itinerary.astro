---
import ArticlePage from '@/components/articles/ArticlePage.astro';
import OsakaItineraryContent from '@/components/articles/OsakaItinerary.astro';
import { osakaItineraryNav } from '@/domains/articles/osaka-itinerary-nav';
import { getArticle } from '@/domains/articles/catalog';

const article = getArticle('osaka-1-day-itinerary')!;
---

<ArticlePage article={article} sections={osakaItineraryNav}>
  <aside
    slot="intro-media"
    class="mt-6 max-w-3xl rounded-lg bg-[#F5F2EB] px-4 py-3 text-sm leading-relaxed text-black/80"
  >
    <span class="font-medium text-black">💡 Pro Tip:</span> Before your trip, I'd recommend setting up an eSIM so you'll have internet access as soon as you arrive. I use Airalo whenever I travel abroad, and having mobile data made it easy to access the interactive map, use Google Maps, and navigate the city from the moment I landed.
  </aside>
  <OsakaItineraryContent />
</ArticlePage>
