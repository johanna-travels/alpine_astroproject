---
import ArticlePage from '@/components/articles/ArticlePage.astro';
import KyotoItineraryContent from '@/components/articles/KyotoItinerary.astro';
import JapanBeforeFooter from '@/components/articles/JapanBeforeFooter.astro';
import ArticleImage from '@/components/ui/ArticleImage.astro';
import kyotoMostIconicPhotoSpot from '@/assets/articles/kyoto/kyoto\'s-most-iconic-photo-spot.webp';
import { kyotoNav } from '@/domains/articles/kyoto-nav';
import { getArticle } from '@/domains/articles/catalog';

const article = getArticle('kyoto-itinerary')!;
---

<ArticlePage article={article} sections={kyotoNav}>
  <ArticleImage
    slot="title-media"
    src={kyotoMostIconicPhotoSpot}
    alt="Kyoto's most iconic photo spot"
    caption="Kyoto's most iconic photo spot"
    imgClass="aspect-[5/4] object-cover"
  />
  <aside
    slot="intro-media"
    class="mt-6 max-w-3xl rounded-lg bg-[#F5F2EB] px-4 py-3 text-md leading-relaxed text-black/80"
  >
    <span class="font-medium text-black">💡 Pro Tip:</span> Before your trip, I'd recommend setting up an eSIM so you'll have internet access as soon as you arrive. I use <a href="https://airalo.pxf.io/c/7435210/1268485/15608" target="_blank" rel="noopener noreferrer sponsored" class="text-[#69746E] underline underline-offset-2 hover:text-[#4a534f]">Airalo</a> whenever I travel abroad, and having mobile data made it easy to access this map, use Google Maps, and navigate the city from the moment I landed.
  </aside>
  <KyotoItineraryContent />
  <JapanBeforeFooter slot="before-footer" currentSlug={article.slug} />
</ArticlePage>
