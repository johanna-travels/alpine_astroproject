---
import ArticlePage from '@/components/articles/ArticlePage.astro';
import ArticleImage from '@/components/ui/ArticleImage.astro';
import BaliBellyContent from '@/components/articles/BaliBelly.astro';
import BaliBeforeFooter from '@/components/articles/BaliBeforeFooter.astro';
import { baliBellyNav } from '@/domains/articles/bali-belly-nav';
import { getArticle } from '@/domains/articles/catalog';
import { buildArticleLcpSrcSet } from '@/lib/images';
import baliBellyCard from '@/assets/articles/bali/bali-belly-card.webp';

const article = getArticle('bali-belly')!;
const lcpImageSrcSet = await buildArticleLcpSrcSet(baliBellyCard);
---

<ArticlePage article={article} sections={baliBellyNav} lcpImageSrcSet={lcpImageSrcSet}>
  <ArticleImage
    slot="title-media"
    src={baliBellyCard}
    alt="Misty Bali rice terraces lined with palm trees at sunrise, with a volcano on the horizon"
    caption="Sunrise over palm-lined rice terraces in Bali, with a volcano in the distance"
    figureClass="mb-6 max-w-3xl md:mb-8"
    imgClass="aspect-[5/4] object-cover"
    priority
  />
  <BaliBellyContent />
  <BaliBeforeFooter slot="before-footer" currentSlug={article.slug} />
</ArticlePage>
