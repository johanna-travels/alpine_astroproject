---
import SanityArticlePage from '@/components/articles/SanityArticlePage.astro';
import { fetchSanityArticle, fetchSanityArticleSlugs } from '@/lib/sanity/queries';

export async function getStaticPaths() {
  const slugs = await fetchSanityArticleSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const article = slug ? await fetchSanityArticle(slug) : null;

if (!article) {
  return Astro.redirect('/404');
}
---

<SanityArticlePage article={article} />
