---
import ArticlePage from '@/components/articles/ArticlePage.astro';
import ArticleClosingNote from '@/components/articles/ArticleClosingNote.astro';
import ArticlePinSaveSection from '@/components/articles/ArticlePinSaveSection.astro';
import ArticleShareBar from '@/components/articles/ArticleShareBar.astro';
import { articleHref, articlesForDestination, getArticle } from '@/domains/articles/catalog';
import ArticlePreviewCard from '@/components/ui/ArticlePreviewCard.astro';
import ArticleImage from '@/components/ui/ArticleImage.astro';
import GetYourGuideCity from '@/components/articles/GetYourGuideCity.astro';
import newCollegeMound from '@/assets/articles/edinburgh/new-college-the-mound.webp';
import nationalGalleryGardens from '@/assets/articles/edinburgh/scottish-national-gallery-princes-street-gardens.webp';
import edinburghGuidePin from '@/assets/articles/edinburgh/edinburgh-travel-guide-pin.webp';
import goldenHareExterior from '@/assets/articles/edinburgh/golden-hare-books-exterior.webp';
import goldenHareInterior from '@/assets/articles/edinburgh/golden-hare-books-interior.webp';
import waterstonesCafe from '@/assets/articles/edinburgh/waterstones-cafe-castle-view.webp';
import waterstonesChristmas from '@/assets/articles/edinburgh/waterstones-christmas-staircase.webp';
import toppingCompanyInterior from '@/assets/articles/edinburgh/topping-company-booksellers-interior.webp';
import victoriaStreetEdinburgh from '@/assets/articles/edinburgh/victoria-street-rainy-colorful-shopfronts.webp';
import victoriaTerraceEdinburgh from '@/assets/articles/edinburgh/victoria-street-victoria-terrace-view.webp';
import royalMile from '@/assets/articles/edinburgh/royal-mile-red-phone-boxes.webp';
import rowlingHandprints from '@/assets/articles/edinburgh/jk-rowling-handprints-city-chambers.webp';
import princesStreet from '@/assets/articles/edinburgh/princes-street-scott-monument.webp';
import grassmarketCastle from '@/assets/articles/edinburgh/grassmarket-edinburgh-castle.webp';
import cockburnStreet from '@/assets/articles/edinburgh/cockburn-street-milkman-corner.webp';
import nationalMuseumOfScotland from '@/assets/articles/edinburgh/national-museum-of-scotland.webp';
import portraitGalleryLibrary from '@/assets/articles/edinburgh/portrait-gallery-library.webp';
import portraitGalleryPaintings from '@/assets/articles/edinburgh/portrait-gallery-paintings.webp';
import portraitGalleryGreatHall from '@/assets/articles/edinburgh/portrait-gallery-great-hall.webp';
import writersMuseumExterior from '@/assets/articles/edinburgh/writers-museum-exterior.webp';
import writersMuseumBusts from '@/assets/articles/edinburgh/writers-museum-busts.webp';
import writersMuseumChess from '@/assets/articles/edinburgh/writers-museum-chess-set.webp';
import circusLaneEdinburgh from '@/assets/articles/edinburgh/circus-lane-edinburgh.webp';
import vennelViewpointEdinburgh from '@/assets/articles/edinburgh/the-vennel-viewpoint-edinburgh.webp';
import rossFountainEdinburgh from '@/assets/articles/edinburgh/ross-fountain-edinburgh-castle.webp';
import deanVillageHouses from '@/assets/articles/edinburgh/dean-village-houses.webp';
import deanVillageRiver from '@/assets/articles/edinburgh/dean-village-water-of-leith.webp';
import newCollegeEdinburgh from '@/assets/articles/edinburgh/new-college-edinburgh.webp';
import caltonHillObservatory from '@/assets/articles/edinburgh/calton-hill-city-observatory.webp';
import caltonHillNationalMonument from '@/assets/articles/edinburgh/calton-hill-national-monument.webp';
import gardenersCottage from '@/assets/articles/edinburgh/gardeners-cottage-princes-street-gardens.webp';
import caltonHillEdinburgh from '@/assets/articles/edinburgh/calton-hill-scotland.webp';
import greyfriarsThomasRiddell from '@/assets/articles/edinburgh/greyfriars-thomas-riddell-grave.webp';
import greyfriarsMcGonagall from '@/assets/articles/edinburgh/greyfriars-william-mcgonagall-plaque.webp';
import elephantHouseInterior from '@/assets/articles/edinburgh/elephant-house-cafe-interior.webp';
import elephantHouseSign from '@/assets/articles/edinburgh/elephant-house-birthplace-sign.webp';
import elephantHouseDesk from '@/assets/articles/edinburgh/elephant-house-writing-desk.webp';
import balmoralHotel from '@/assets/articles/edinburgh/balmoral-hotel-edinburgh.webp';
import roomAndRumoursPastries from '@/assets/articles/edinburgh/room-and-rumours-pastries.webp';
import roomAndRumoursDoughnut from '@/assets/articles/edinburgh/room-and-rumours-doughnut-coffee.webp';
import booksNCupStockbridge from '@/assets/articles/edinburgh/books-n-cup-stockbridge.webp';
import booksNCupTollcross from '@/assets/articles/edinburgh/books-n-cup-tollcross.webp';
import uplandsRoastHotChocolate from '@/assets/articles/edinburgh/uplands-roast-hot-chocolate.webp';
import greyfriarsKirkyard from '@/assets/articles/edinburgh/greyfriars-kirkyard-edinburgh.webp';

const article = getArticle('things-to-do-in-edinburgh')!;
const mapLink = 'text-[#69746E] underline underline-offset-2 hover:text-[#4a534f]';
const rainyDayHref = articleHref('things-to-do-in-edinburgh-on-a-rainy-day');
const relatedArticles = articlesForDestination('scotland')
  .filter((a) => a.slug !== article.slug)
  .map((a) => ({
    href: articleHref(a.slug),
    image: a.image,
    category: a.category,
    title: a.title,
    alt: a.alt,
    comingSoon: a.comingSoon,
  }));
const sections = [
  { navTitle: 'Intro', target: 'section-intro' },
  { navTitle: 'How to Get to Edinburgh', target: 'getting-there' },
  { navTitle: 'How to Get Around Edinburgh', target: 'getting-around' },
  {
    navTitle: 'Best Things to Do in Edinburgh',
    target: 'things-to-do',
    children: [
      { navTitle: '1. Explore Edinburgh’s Bookshops', target: 'bookshops' },
      { navTitle: '2. Wander the Streets and Squares', target: 'streets-and-squares' },
      { navTitle: '3. Visit Edinburgh Castle', target: 'edinburgh-castle' },
      { navTitle: '4. Explore Edinburgh’s Museums', target: 'museums' },
      { navTitle: '5. Discover the Most Photogenic Spots', target: 'photo-spots' },
      { navTitle: '6. Watch the Sunrise from Calton Hill', target: 'calton-hill' },
      { navTitle: '7. Harry Potter Locations', target: 'harry-potter' },
      { navTitle: '8. Discover Scotland’s Whisky Culture', target: 'whisky' },
      { navTitle: '9. Experience Edinburgh’s Pub Culture', target: 'pubs' },
      { navTitle: '10. Join a Ghost Tour', target: 'ghost-tour' },
    ],
  },
  { navTitle: 'Where to Eat in Edinburgh', target: 'where-to-eat' },
  { navTitle: 'Cozy Cafés in Edinburgh', target: 'cafes' },
  { navTitle: 'Where to Stay in Edinburgh', target: 'where-to-stay' },
  {
    navTitle: 'FAQ',
    target: 'faq',
    children: [
      { navTitle: '1. How many days do you need in Edinburgh?', target: 'faq-0' },
      { navTitle: '2. What is the best time of year to visit Edinburgh?', target: 'faq-1' },
      { navTitle: '3. Is Edinburgh an expensive city to visit?', target: 'faq-2' },
      { navTitle: '4. Is Edinburgh a walkable city?', target: 'faq-3' },
      { navTitle: '5. Do you need to book Edinburgh Castle tickets in advance?', target: 'faq-4' },
      { navTitle: '6. What are the best free things to do in Edinburgh?', target: 'faq-5' },
      { navTitle: '7. What should you pack for a trip to Edinburgh?', target: 'faq-6' },
      { navTitle: '8. Where is the best area to stay in Edinburgh?', target: 'faq-7' },
      { navTitle: '9. Is Edinburgh worth visiting for a weekend?', target: 'faq-8' },
    ],
  },
  { navTitle: 'Before You Go', target: 'before-you-go' },
] as const;
---

<ArticlePage article={article} sections={sections}>
  <figure slot="title-media">
    <ArticleImage
      src={article.lcpImage!}
      alt="Edinburgh’s Old Town and Edinburgh Castle at sunrise, seen from Calton Hill"
      caption="Sunrise over Edinburgh from Calton Hill"
      imgClass="aspect-[5/4] object-cover"
      priority
    />
  </figure>

  <GetYourGuideCity locationId="44" />

  <section id="getting-there" class="scroll-mt-nav">
    <div class="mb-5 max-w-3xl text-black md:mb-6">
      <h2 class="text-xl md:text-2xl font-semibold text-neutral-900 mb-4">How to Get to Edinburgh</h2>
    </div>
    <div class="article-prose max-w-3xl text-black/80 [&_p]:mb-5 [&_p:last-child]:mb-0">
      <p>If you’re flying to Edinburgh, you’ll land at Edinburgh Airport, which is located around 12 km from the city centre. Getting from the airport to the city is quite straightforward, with two convenient options available: the Airlink 100 bus and the Edinburgh Tram.</p>
      <p>The option I personally used was the Airlink 100 bus, and I’d definitely recommend it if you’re heading towards the city centre. The bus takes around 30 minutes to reach Waverley Bridge, close to Princes Street and the main train station. It also runs very frequently, with departures every 10 minutes or so during the day, meaning you won’t have to wait long after landing. You can simply buy your ticket directly from the driver when boarding, so there’s no need to worry about booking it in advance.</p>
      <p>Alternatively, you can take the Edinburgh Tram, which also connects the airport with the city centre in around 30 minutes. Trams run frequently throughout the day, making this another convenient option, particularly if there’s a stop closer to your accommodation. You can purchase your ticket from the machines at the tram stop or use contactless payment.</p>
      <ArticleImage
        src={newCollegeMound}
        alt="The Gothic towers of New College rising above the green slopes of The Mound in Edinburgh"
        caption="New College towering above The Mound"
        imgClass="aspect-[2/3] object-cover"
      />
    </div>
  </section>

  <section id="getting-around" class="scroll-mt-nav">
    <div class="mb-5 max-w-3xl text-black md:mb-6">
      <h2 class="text-xl md:text-2xl font-semibold text-neutral-900 mb-4">How to Get Around Edinburgh</h2>
    </div>
    <div class="article-prose max-w-3xl text-black/80 [&_p]:mb-5 [&_p:last-child]:mb-0">
      <p>One of the best things about exploring Edinburgh is that you can easily get around on foot. Most of the main attractions are within walking distance of each other, so you won’t need to rely on public transport all the time. In fact, I’d recommend exploring the city on foot as much as possible, as you’ll come across plenty of charming streets and little hidden corners along the way.</p>
      <p>However, if you need to travel a little further, Edinburgh has a reliable network of buses and trams. I’d recommend downloading the <strong>Bus &amp; Tram app</strong>, which makes it easy to check routes, plan your journeys and purchase tickets directly from your phone.</p>
      <p>You can also pay for your bus journeys using contactless payment, either with your bank card or your phone, which makes getting around even more convenient. Simply tap your card or device on the reader when you board, and you’re good to go. There’s no need to tap off when leaving the bus.</p>
      <p>If you decide to use the tram, the contactless system works slightly differently. You’ll need to tap your card or phone on the platform reader before boarding and remember to tap off again when you reach your destination. Just make sure you use the same card or device for both taps to ensure your journey is registered correctly.</p>
      <ArticleImage
        src={nationalGalleryGardens}
        alt="Scottish National Gallery above Princes Street Gardens, with Edinburgh Castle behind"
        caption="Scottish National Gallery above Princes Street Gardens"
        imgClass="aspect-[4/5] object-cover"
      />
    </div>
  </section>

  <section id="things-to-do" class="scroll-mt-nav">
    <div class="mb-5 max-w-3xl text-black md:mb-6">
      <h2 class="text-xl md:text-2xl font-semibold text-neutral-900 mb-4">Best Things to Do in Edinburgh</h2>
    </div>
    <div class="article-prose max-w-3xl text-black/80 [&_p]:mb-5 [&_p:last-child]:mb-0">
      <p>Here are some of my top recommendations for things to do in Edinburgh, from exploring its beautiful streets and historic landmarks to discovering some of the city’s hidden corners.</p>

      <section class="mt-12">
        <h3 id="bookshops" class="mb-4 scroll-mt-nav text-lg font-semibold text-neutral-900 md:text-xl">1. Explore Edinburgh’s Bookshops</h3>
        <p>Edinburgh has a wonderful selection of bookshops, and part of the fun is discovering just how different they can be. From cozy independent stores with a welcoming atmosphere to impressive bookstores with beautiful interiors, these are three places I’d recommend stopping by during your visit.</p>
        <ul class="mt-8 list-disc space-y-8 pl-5 marker:text-black/40">
          <li class="pl-1">
            <p><strong>Golden Hare Books:</strong> Located in Stockbridge, this independent bookshop has a warm and welcoming atmosphere, with a real fireplace that makes it especially cozy on colder days. The friendly staff and carefully curated selection of books make it a lovely place to browse at your own pace.</p>
            <div class="grid grid-cols-2 gap-3 md:gap-4">
              <ArticleImage
                src={goldenHareExterior}
                alt="Exterior of Golden Hare Books in Stockbridge, Edinburgh"
                caption="Golden Hare Books in Stockbridge"
                imgClass="aspect-[4/5] object-cover"
              />
              <ArticleImage
                src={goldenHareInterior}
                alt="Book-lined interior of Golden Hare Books"
                caption="Inside Golden Hare Books"
                imgClass="aspect-[4/5] object-cover"
              />
            </div>
          </li>
          <li class="pl-1">
            <p><strong>Waterstones, Princes Street:</strong> This large bookstore is spread across several floors and offers a wide selection of books. One of its highlights is the café upstairs, where you can sit down with a coffee and enjoy beautiful views of Edinburgh Castle.</p>
            <ArticleImage
              src={waterstonesChristmas}
              alt="Christmas decorations inside Waterstones Edinburgh"
              caption="Christmas decorations inside Waterstones Edinburgh"
              imgClass="aspect-[5/4] object-cover"
            />
            <ArticleImage
              src={waterstonesCafe}
              alt="Waterstones cafe with Edinburgh Castle view"
              caption="Waterstones cafe with Edinburgh Castle view"
              imgClass="aspect-[4/5] object-cover"
            />
          </li>
          <li class="pl-1">
            <p><strong>Topping &amp; Company Booksellers:</strong> If you love beautiful bookshops, this one is well worth a visit. Its impressive interior features floor-to-ceiling bookshelves, rolling library ladders, large windows and plenty of natural light, creating a space that’s just as enjoyable to explore as the books themselves.</p>
            <ArticleImage
              src={toppingCompanyInterior}
              alt="The book-lined interior of Topping & Company Booksellers"
              caption="Inside Topping & Company Booksellers"
              imgClass="aspect-[2/3] object-cover"
            />
          </li>
        </ul>
      </section>

      <GetYourGuideCity locationId="2592" class="mt-12 max-w-3xl" />

      <section class="mt-12">
        <h3 id="streets-and-squares" class="mb-4 scroll-mt-nav text-lg font-semibold text-neutral-900 md:text-xl">2. Wander Through Edinburgh’s Most Beautiful Streets and Squares</h3>
        <p>One of the best ways to get to know Edinburgh is simply to wander around its streets. From colorful little lanes and winding cobbled streets to lively squares and elegant shopping avenues, there’s always something interesting to discover. Here are a few spots worth looking out for as you explore the city.</p>
        <ul class="mt-8 list-disc space-y-8 pl-5 marker:text-black/40">
          <li class="pl-1">
            <p><strong>Victoria Street:</strong> Probably one of the most recognizable streets in Edinburgh, Victoria Street is known for its colorful curved buildings, independent shops and charming little storefronts. It’s often compared to Diagon Alley from Harry Potter, and it’s easy to see why. Take your time walking along the street and don’t forget to look back for a lovely view of its colorful façades.</p>
            <ArticleImage
              src={victoriaStreetEdinburgh}
              alt="Colorful curved shopfronts along a rainy Victoria Street in Edinburgh"
              caption="Colorful shopfronts on Victoria Street"
              imgClass="aspect-[5/4] object-cover"
            />
            <ArticleImage
              src={victoriaTerraceEdinburgh}
              alt="View over Victoria Street from Victoria Terrace"
              caption="Victoria Street from Victoria Terrace"
              imgClass="aspect-[4/5] object-cover"
            />
          </li>
          <li class="pl-1">
            <p><strong>The Royal Mile:</strong> Stretching through the heart of Edinburgh’s Old Town, the Royal Mile connects Edinburgh Castle with the Palace of Holyroodhouse. Along the way, you’ll pass historic buildings, little alleyways known as closes, traditional shops and plenty of places worth stopping to explore. Make sure to visit St Giles’ Cathedral and look out for J.K. Rowling’s handprints in the courtyard of the City Chambers.</p>
            <div class="grid grid-cols-2 gap-3 md:gap-4">
              <ArticleImage
                src={royalMile}
                alt="Red phone boxes on a rainy Royal Mile, with the Tron Kirk spire behind"
                caption="The Royal Mile on a rainy day"
                imgClass="aspect-[4/5] object-cover"
              />
              <ArticleImage
                src={rowlingHandprints}
                alt="J.K. Rowling’s handprints in the courtyard of the City Chambers"
                caption="J.K. Rowling’s handprints"
                imgClass="aspect-[4/5] object-cover"
              />
            </div>
          </li>
          <li class="pl-1">
            <p><strong>Cockburn Street:</strong> With its curved shape, beautiful old buildings and independent shops, Cockburn Street is another lovely street to wander through. It’s particularly photogenic, especially around the corner near The Milkman café, where you can capture one of those classic Edinburgh street views.</p>
            <ArticleImage
              src={cockburnStreet}
              alt="Cockburn Street’s curved cobbled corner by The Milkman café in Edinburgh"
              caption="Cockburn Street, by The Milkman café"
              imgClass="aspect-[2/3] object-cover"
            />
          </li>
          <li class="pl-1">
            <p><strong>Grassmarket:</strong> This historic square is one of the most picturesque spots in the Old Town. Surrounded by colorful buildings, traditional pubs and restaurants, it has a lively atmosphere throughout the day. It’s also a great place to stop for a drink or something to eat, with a beautiful view of Edinburgh Castle from the square.</p>
            <ArticleImage
              src={grassmarketCastle}
              alt="Edinburgh Castle overlooking Grassmarket"
              caption="Edinburgh Castle overlooking Grassmarket"
              imgClass="aspect-[2/3] object-cover"
            />
          </li>
          <li class="pl-1">
            <p><strong>Princes Street:</strong> For a different side of the city, head to Princes Street, Edinburgh’s main shopping street. It’s lined with shops and department stores, but what makes it particularly special is the open view of Edinburgh Castle and the Old Town across Princes Street Gardens. It’s worth a stroll even if shopping isn’t on your list.</p>
            <ArticleImage
              src={princesStreet}
              alt="The Scott Monument on Princes Street under a cloudy sky"
              caption="The Scott Monument on Princes Street"
              imgClass="aspect-[4/5] object-cover"
            />
          </li>
        </ul>
      </section>

      <section class="mt-12">
        <h3 id="edinburgh-castle" class="mb-4 scroll-mt-nav text-lg font-semibold text-neutral-900 md:text-xl">3. Visit Edinburgh Castle</h3>
        <p>Standing high above the city on Castle Rock, Edinburgh Castle is one of Scotland’s most famous landmarks and a must-see during your visit. With a history dating back almost 1,000 years, the castle has played an important role in Scotland’s past and offers plenty to explore, from the Crown Jewels and the Stone of Destiny to the Great Hall and St Margaret’s Chapel, the oldest surviving building in Edinburgh. Don’t miss the chance to enjoy the impressive views over the city from its walls. It’s one of Edinburgh’s most popular attractions, so I’d recommend booking your tickets in advance, especially during the busier months.</p>
        <div
          data-gyg-href="https://widget.getyourguide.com/default/activities.frame"
          data-gyg-locale-code="en-US"
          data-gyg-widget="activities"
          data-gyg-number-of-items="3"
          data-gyg-cmp="Edinburgh_post"
          data-gyg-partner-id="VMRSHXF"
          data-gyg-q="Edinburgh castle tour"
          class="my-6 max-w-3xl md:my-8"
        >
          <span>Powered by <a target="_blank" rel="sponsored" href="https://www.getyourguide.com/s/%3Fq=Edinburgh&amp;lc=44&amp;et=1189554&amp;searchSource=3&amp;src=search_bar">GetYourGuide</a></span>
        </div>
      </section>

      <section class="mt-12">
        <h3 id="museums" class="mb-4 scroll-mt-nav text-lg font-semibold text-neutral-900 md:text-xl">4. Explore Edinburgh’s Museums</h3>
        <p>Edinburgh has some wonderful museums, and even if you’re not planning to spend hours indoors, these three are well worth a visit. Here are a few I’d recommend adding to your itinerary.</p>
        <ul class="mt-8 list-disc space-y-8 pl-5 marker:text-black/40">
          <li class="pl-1">
            <p><strong>National Museum of Scotland:</strong> One of the most impressive museums in the city, with collections covering everything from science and technology to Scottish history. You may have heard of some of its famous exhibits, such as Dolly the sheep or the Lewis Chessmen, but what I loved most was seeing an old personal computer from 1977. It really made me stop and think about how much technology has changed in such a short time. I think that’s part of what makes this museum so interesting: everyone can come away having discovered something different.</p>
            <ArticleImage
              src={nationalMuseumOfScotland}
              alt="The Grand Gallery inside the National Museum of Scotland"
              caption="The Grand Gallery at the National Museum of Scotland"
              imgClass="aspect-[2/3] object-cover"
            />
          </li>
          <li class="pl-1">
            <p><strong>Scottish National Portrait Gallery:</strong> Even if you’re not particularly interested in art, I’d still recommend stepping inside this gallery. The building itself is beautiful, and its impressive Great Hall, with its decorated walls, stained glass and stunning ceiling, is worth seeing on its own. It’s a lovely stop, even if you only have a little time to spare.</p>
            <ArticleImage
              src={portraitGalleryLibrary}
              alt="Historic library with portrait busts and displays at the Scottish National Portrait Gallery"
              caption="Historic library with portrait busts and displays"
              imgClass="aspect-[2/3] object-cover"
            />
            <div class="grid grid-cols-2 gap-3 md:gap-4">
              <ArticleImage
                src={portraitGalleryPaintings}
                alt="Exploring portraits at Edinburgh’s National Portrait Gallery"
                caption="Exploring portraits at Edinburgh’s National Portrait Gallery"
                imgClass="aspect-[4/5] object-cover"
              />
              <ArticleImage
                src={portraitGalleryGreatHall}
                alt="The impressive architecture of the Scottish National Portrait Gallery"
                caption="The impressive architecture of the Scottish National Portrait Gallery"
                imgClass="aspect-[4/5] object-cover"
              />
            </div>
          </li>
          <li class="pl-1">
            <p><strong>The Writers’ Museum:</strong> Tucked away in a small close just off the Royal Mile, this free museum is dedicated to three of Scotland’s most celebrated writers: Robert Burns, Sir Walter Scott and Robert Louis Stevenson. Inside, you’ll find personal belongings, rare books, portraits and objects connected to their lives and work. It’s a lovely little stop, especially if you enjoy literature.</p>
            <ArticleImage
              src={writersMuseumExterior}
              alt="The entrance to The Writers’ Museum in Lady Stair’s Close, Edinburgh"
              caption="The Writers’ Museum"
              imgClass="aspect-[2/3] object-cover"
            />
            <div class="grid grid-cols-2 gap-3 md:gap-4">
              <ArticleImage
                src={writersMuseumBusts}
                alt="Busts of Robert Burns, Sir Walter Scott and Robert Louis Stevenson at The Writers’ Museum"
                caption="Burns, Scott and Stevenson"
                imgClass="aspect-[4/5] object-cover"
              />
              <ArticleImage
                src={writersMuseumChess}
                alt="Sir Walter Scott’s carved chess set on display at The Writers’ Museum"
                caption="Sir Walter Scott’s chess set"
                imgClass="aspect-[4/5] object-cover"
              />
            </div>
          </li>
        </ul>
      </section>

      <section class="mt-12">
        <h3 id="photo-spots" class="mb-4 scroll-mt-nav text-lg font-semibold text-neutral-900 md:text-xl">5. Discover Edinburgh’s Most Photogenic Spots</h3>
        <p>Edinburgh has no shortage of beautiful corners, and some places are simply too pretty not to stop and take a few photos. Here are a few of my favorite photo spots around the city.</p>
        <ul class="mt-8 list-disc space-y-8 pl-5 marker:text-black/40">
          <li class="pl-1">
            <p><strong>Circus Lane:</strong> A quiet, cobbled little street in Stockbridge, known for its charming old houses and the distinctive church tower at the end of the lane. It’s a very quick stop for a few photos, but definitely worth adding to your list. Just a little further up the street, you’ll also find one of my favorite bookshops in Edinburgh, Golden Hare Books.</p>
            <ArticleImage
              src={circusLaneEdinburgh}
              alt="Circus Lane in Stockbridge, Edinburgh"
              caption="Circus Lane in Stockbridge"
              imgClass="aspect-[2/3] object-cover"
            />
          </li>
          <li class="pl-1">
            <p><strong>Dean Village:</strong> This is one of my favorite corners of Edinburgh. With its old stone houses, little bridges and the Water of Leith running through it, the whole place has an almost fairytale-like feel. If you love places with a fairytale vibe, I think you’ll absolutely love it here.</p>
            <ArticleImage
              src={deanVillageHouses}
              alt="Colorful old houses above the Water of Leith in Dean Village, Edinburgh"
              caption="Dean Village and the Water of Leith"
              imgClass="aspect-[5/4] object-cover"
            />
            <ArticleImage
              src={deanVillageRiver}
              alt="The iconic Well Court in Dean Village, seen across the Water of Leith"
              caption="The iconic Well Court in Dean Village"
              imgClass="aspect-[2/3] object-cover"
            />
          </li>
          <li class="pl-1">
            <p><strong>The Vennel Viewpoint:</strong> I visited this spot twice, once on a sunny day and once when it was raining. Surprisingly, I found it much easier to take photos on the rainy day, as there were far fewer people around. And with that beautiful view of Edinburgh Castle framed by the steps, it’s easy to see why this is one of the city’s most popular photo spots.</p>
            <ArticleImage
              src={vennelViewpointEdinburgh}
              alt="The Vennel steps and Edinburgh Castle on a rainy day"
              caption="Edinburgh Castle from The Vennel"
              imgClass="aspect-[5/4] object-cover"
            />
          </li>
          <li class="pl-1">
            <p><strong>Princes Street Gardens and Ross Fountain:</strong> For one of the classic Edinburgh photos, head to the Ross Fountain, with Edinburgh Castle rising in the background. While you’re exploring the gardens, don’t miss the charming little Gardener’s Cottage, a lovely spot that you might otherwise walk straight past.</p>
            <ArticleImage
