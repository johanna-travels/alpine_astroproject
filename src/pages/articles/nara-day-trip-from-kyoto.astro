---
import ArticlePage from '@/components/articles/ArticlePage.astro';
import NaraDayTripContent from '@/components/articles/NaraDayTrip.astro';
import JapanBeforeFooter from '@/components/articles/JapanBeforeFooter.astro';
import { naraDayTripNav } from '@/domains/articles/nara-day-trip-nav';
import { getArticle } from '@/domains/articles/catalog';
import ArticleImage from '@/components/ui/ArticleImage.astro';
import naraDeer from '@/assets/articles/kyoto/nara-deer-by-the-pond.webp';

const article = getArticle('nara-day-trip-from-kyoto')!;
---

<ArticlePage article={article} sections={naraDayTripNav}>
  <figure slot="title-media">
    <ArticleImage src={naraDeer} alt="The Deer of Nara Park" caption="The Deer of Nara Park" imgClass="aspect-[5/4] object-cover" />
  </figure>
  <aside
    slot="intro-media"
    class="mt-6 max-w-3xl rounded-lg bg-[#F5F2EB] px-4 py-3 text-md leading-relaxed text-black/80"
  >
    📍 You'll find every stop mentioned in this guide pinned on my Kyoto 3-Day Itinerary Map, making it easy to follow the same route during your visit. 
  </aside>
  <NaraDayTripContent />
  <JapanBeforeFooter slot="before-footer" currentSlug={article.slug} />
</ArticlePage>
