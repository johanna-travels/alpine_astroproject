---
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/layout/Footer.astro';
import PageNav from '@/components/layout/PageNav.astro';
import { Image } from 'astro:assets';
import greeceArticleImg from '@/assets/articles/Article Greece.webp';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout>
  <PageNav />
  <main class="min-h-screen bg-white text-neutral-900 px-4 md:px-10 pb-24 pt-12">
    <h1 class="mb-8">Greece</h1>
    <p class="prose-body text-neutral-600 max-w-3xl">
      Discover the beauty of Greece — from ancient ruins to stunning islands.
    </p>

    <div class="relative lg:ml-[120px] lg:mb-[50px]">
      <div class="pt-8 pb-8 md:px-[40px]">
        <a href={`${base}/destinations`} class="slide group block">
          <div class="slide-media relative aspect-square w-full max-w-[400px] mx-auto overflow-hidden rounded-xl">
            <Image
              src={greeceArticleImg}
              alt="Greece article"
              width={800}
              height={800}
              densities={[1, 2]}
              class="slide-image absolute inset-0 w-full h-full object-cover transition-opacity duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent pointer-events-none z-10"></div>
          </div>
          <div class="pt-4 px-1 max-w-[400px] mx-auto">
            <span class="meta block text-black mb-1">GREECE</span>
            <h3 class="text-[#1e1e1e] mb-2">Rhodes 5-Day Itinerary</h3>
            <span class="text-[0.875rem] font-medium text-black inline-flex items-center gap-2 transition-all">
              Read more
              <span class="leading-none transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">→</span>
            </span>
          </div>
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
