---
import PageShell from '@/components/layout/PageShell.astro';
import { apiUrl, pageUrl } from '@/lib/site';
---

<PageShell noindex title="Subscription Preferences — Voyaflair">
  <div class="min-h-screen bg-white py-16 px-4">
    <div class="max-w-2xl mx-auto">
      <h1 class="mb-8 text-neutral-900">Subscription Preferences</h1>

      <div id="preferences-root" class="hidden">
        <div id="preferences-confirmed" class="hidden mb-6 rounded-lg border border-green-200 bg-green-50 p-4 text-green-800">
          <p class="font-medium">Your subscription is confirmed.</p>
          <p class="mt-1 text-sm">You can now receive travel updates from Voyaflair.</p>
        </div>

        <div class="rounded-lg bg-white p-8 shadow-lg">
          <div class="mb-6">
            <p class="text-sm text-gray-600">Email: <span id="subscriber-email" class="font-medium"></span></p>
            <p class="text-sm text-gray-600">Status: <span id="subscriber-status" class="font-medium capitalize"></span></p>
          </div>

          <form id="preferences-form" class="space-y-6">
            <div>
              <h3 class="mb-3">Email Preferences</h3>

              <label class="mb-3 flex cursor-pointer items-center gap-3">
                <input
                  type="checkbox"
                  name="updates"
                  class="h-5 w-5 rounded border-gray-300"
                />
                <span class="text-gray-700">Travel updates and new articles</span>
              </label>

              <label class="flex cursor-pointer items-center gap-3">
                <input
                  type="checkbox"
                  name="promotions"
                  class="h-5 w-5 rounded border-gray-300"
                />
                <span class="text-gray-700">Special offers and promotions</span>
              </label>
            </div>

            <div class="flex gap-4">
              <button
                type="submit"
                class="rounded-md bg-neutral-900 px-6 py-2 text-white transition-colors hover:bg-neutral-800"
              >
                Save Preferences
              </button>

              <button
                type="button"
                id="unsubscribe-btn"
                class="rounded-md border border-red-300 px-6 py-2 text-red-600 transition-colors hover:bg-red-50"
              >
                Unsubscribe
              </button>
            </div>
          </form>
        </div>
      </div>

      <div id="preferences-error" class="hidden rounded-lg border border-red-200 bg-red-50 p-6 text-red-800">
        <p id="preferences-error-text"></p>
        <a href={pageUrl()} class="mt-2 inline-block underline">Return to home</a>
      </div>

      <div id="preferences-empty" class="hidden rounded-lg border border-yellow-200 bg-yellow-50 p-6 text-yellow-800">
        <p>No valid token provided. Please use the link from your confirmation email.</p>
        <a href={pageUrl()} class="mt-2 inline-block underline">Return to home</a>
      </div>
    </div>
  </div>
</PageShell>

<script define:vars={{ preferencesApi: apiUrl('preferences'), subscriberApi: apiUrl('subscriber'), homePath: pageUrl() }}>
  function showError(message) {
    document.getElementById('preferences-root')?.classList.add('hidden');
    document.getElementById('preferences-empty')?.classList.add('hidden');
    const errorBox = document.getElementById('preferences-error');
    const errorText = document.getElementById('preferences-error-text');
    if (errorText) errorText.textContent = message;
    errorBox?.classList.remove('hidden');
  }

  function renderSubscriber(subscriber, confirmed) {
    document.getElementById('preferences-error')?.classList.add('hidden');
    document.getElementById('preferences-empty')?.classList.add('hidden');
    document.getElementById('preferences-root')?.classList.remove('hidden');

    if (confirmed || subscriber.status === 'active') {
      document.getElementById('preferences-confirmed')?.classList.remove('hidden');
    }

    const emailEl = document.getElementById('subscriber-email');
    const statusEl = document.getElementById('subscriber-status');
    if (emailEl) emailEl.textContent = subscriber.email;
    if (statusEl) statusEl.textContent = subscriber.status;

    const form = document.getElementById('preferences-form');
    const updates = form?.querySelector('[name="updates"]');
    const promotions = form?.querySelector('[name="promotions"]');
    if (updates) updates.checked = Boolean(subscriber.preferences?.updates);
    if (promotions) promotions.checked = Boolean(subscriber.preferences?.promotions);
  }

  async function initPreferences() {
    const root = document.getElementById('preferences-root');
    if (root?.dataset.bound === 'true') return;
    if (root) root.dataset.bound = 'true';

    const params = new URLSearchParams(window.location.search);
    const token = params.get('token');
    const confirmed = params.get('confirmed') === '1';
    const error = params.get('error');

    if (error === 'missing-token' || error === 'invalid-token') {
      showError(error === 'invalid-token' ? 'Invalid or expired confirmation link.' : 'Missing confirmation token.');
      return;
    }

    if (!token) {
      document.getElementById('preferences-error')?.classList.add('hidden');
      document.getElementById('preferences-root')?.classList.add('hidden');
      document.getElementById('preferences-empty')?.classList.remove('hidden');
      return;
    }

    try {
      const response = await fetch(`${subscriberApi}?token=${encodeURIComponent(token)}`);
      const result = await response.json();

      if (!response.ok) {
        showError(result.error || 'Invalid or expired confirmation link.');
        return;
      }

      renderSubscriber(result.subscriber, confirmed);
    } catch {
      showError('Network error. Please try again.');
      return;
    }

    const form = document.getElementById('preferences-form');
    const unsubscribeBtn = document.getElementById('unsubscribe-btn');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const preferences = {
        updates: formData.get('updates') === 'on',
        promotions: formData.get('promotions') === 'on',
      };

      try {
        const response = await fetch(preferencesApi, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, preferences }),
        });
        const result = await response.json();

        if (response.ok) {
          alert('Preferences saved successfully!');
          window.location.reload();
        } else {
          alert(result.error || 'Failed to save preferences');
        }
      } catch {
        alert('Network error. Please try again.');
      }
    });

    unsubscribeBtn?.addEventListener('click', async () => {
      if (!confirm('Are you sure you want to unsubscribe?')) return;

      try {
        const response = await fetch(preferencesApi, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token }),
        });
        const result = await response.json();

        if (response.ok) {
          alert('Successfully unsubscribed');
          window.location.href = homePath;
        } else {
          alert(result.error || 'Failed to unsubscribe');
        }
      } catch {
        alert('Network error. Please try again.');
      }
    });
  }

  initPreferences();
  document.addEventListener('astro:page-load', initPreferences);
</script>
