---
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/layout/Footer.astro';
import PageNav from '@/components/layout/PageNav.astro';
import { Image } from 'astro:assets';
import brugesArticleImg from '@/assets/articles/Article Bruges.webp';
import StickyScrollRevealDemo from '@/components/sticky-scroll-reveal-demo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout>
  <PageNav />
  <main class="min-h-screen text-neutral-900 px-4 md:px-10 pb-24 pt-12" style="background-color: var(--color-bg)">
    <StickyScrollRevealDemo client:idle />
  </main>
  <Footer />
</Layout>
