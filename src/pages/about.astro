---
import PageShell from '@/components/layout/PageShell.astro';
import PageBreadcrumbHero from '@/components/sections/PageBreadcrumbHero.astro';
import ContactSectionWithShader from '@/components/sections/contact-section-with-shader.tsx';
import { Image } from 'astro:assets';
import heroImg from '@/assets/heroes/about-me.webp';
import verticalImg from '@/assets/heroes/about-me-vertical.webp';
import { getResponsiveHero, getSocialShareImage, heroImageSizes } from '@/lib/images';
import { pageUrl } from '@/lib/site';

const hero = await getResponsiveHero(heroImg);
const shareImage = await getSocialShareImage(heroImg);
---

<PageShell
  title="About — Voyaflair"
  description="Meet Joanna, creator of Voyaflair — a personal travel journal sharing destinations, stays, and experiences worth remembering."
  image={shareImage.src}
  imageAlt="Joanna at a scenic travel destination — About Voyaflair"
  imageWidth={shareImage.width}
  imageHeight={shareImage.height}
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={hero.src}
      imagesrcset={hero.srcSet}
      imagesizes={heroImageSizes}
      fetchpriority="high"
    />
  </Fragment>

  <PageBreadcrumbHero
    title="About Me"
    currentPage="About Me"
    currentHref={pageUrl('about')}
    imageSrc={hero.src}
    desktopImageSrc={hero.largeSrc}
    imageSrcSet={hero.srcSet}
    imageSizes={hero.sizes}
    imageClass="object-right lg:object-center"
    imageAlt="Joanna at a scenic travel destination — About Voyaflair"
  />

  <main class="relative z-10 bg-white text-neutral-900">
    <div class="flex flex-col gap-8 pb-16 pt-8 md:gap-8 md:pb-16 md:pt-10 lg:gap-12 lg:pb-24 lg:pt-12 xl:gap-16 xl:pt-16">
      <section>
        <div class="section-gutter">
          <div class="grid w-full grid-cols-1 gap-5 lg:grid-cols-2 lg:gap-x-12 xl:gap-x-[100px]">
            <div class="relative aspect-[3/4] min-h-0 overflow-hidden bg-neutral-100 lg:aspect-auto lg:h-full">
              <Image
                class="h-full w-full object-cover transition-transform duration-700 hover:scale-105 lg:absolute lg:inset-0"
                  src={verticalImg}
                  alt="Profile"
                  loading="lazy"
                  decoding="async"
                  widths={[480, 720, 900]}
                  sizes="(min-width: 1024px) 50vw, 100vw"
                  format="webp"
                  quality={75}
                />
            </div>

            <article class="flex w-full flex-col gap-y-4 lg:gap-y-5">
              <div class="h-[1px] w-10 bg-neutral-900 opacity-20"></div>
              <p class="meta text-neutral-500">About Me</p>
              <h2>My Little Story</h2>
              <p class="prose-body border-l-2 border-white pl-4 italic text-neutral-600">
                Hi, I’m Joanna — originally from Greece and now based in Oslo.
              </p>
              <p class="prose-body text-neutral-700">
                I started traveling abroad almost ten years ago, and since then, travel has become a big part of my life. I’ve been fortunate enough to visit more than 20 countries — and I’ve returned to many of them more than once. While I love discovering new places, I also enjoy returning to destinations I already love. There is always something new to discover — a different neighborhood, a hidden café, a local experience I missed the first time, or simply a new way of seeing a familiar place. And if you’re wondering what makes a destination one of my favorites, it’s never just one thing. It’s the combination of many things: the food, the atmosphere, the people you meet, the adventures you have, and all those small moments that stay with you long after you return home.
              </p>
              <p class="prose-body text-neutral-700">
                Long before I began sharing my travels online, I was the person who would spend hours researching destinations, comparing places to stay, saving beautiful cafés and restaurants, and putting together detailed itineraries. I genuinely enjoyed the planning process almost as much as the trip itself. After every trip, friends would often ask me about my experiences: Which places did I love? Where should they stay? What was worth adding to their itinerary? What would I do differently next time? Over time, I realized that all the research and planning I enjoyed so much could also be useful to other people.
              </p>
              <p class="prose-body text-neutral-700">
                So, years later, I created my <a href="https://www.instagram.com/voyaflair?igsh=eTc2YnVldXlneHB2&utm_source=qr" target="_blank" rel="noopener noreferrer" class="text-[#69746E] underline underline-offset-2 hover:text-[#4a534f]">Instagram</a> account as a place to share beautiful destinations that I genuinely believe are worth experiencing, along with practical travel tips — especially the kind of advice I wish someone had given me before some of my own trips. But there was always more I wanted to share than could fit into a post. More details, more recommendations, more context, and, of course, complete itineraries that could help make travel planning feel a little easier. That’s how this blog began.
              </p>
              <p class="prose-body text-neutral-700">
                This is where I share carefully chosen destinations, meaningful stays, memorable experiences, useful travel tips, and thoughtfully planned itineraries. Some guides are here to help you plan a trip from start to finish; others are simply meant to inspire your next journey. My hope is that Voyaflair can save you some time, help you discover places you might not have found otherwise, and make planning your trip feel more enjoyable — leaving you with a little more time to look forward to the journey… and pack your suitcase.
              </p>
            </article>
          </div>
        </div>
      </section>

      <ContactSectionWithShader client:idle stacked />
    </div>
  </main>

</PageShell>
