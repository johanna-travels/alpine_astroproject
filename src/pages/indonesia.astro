---
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/layout/Footer.astro';
import PageNav from '@/components/layout/PageNav.astro';
---

<Layout>
  <PageNav />
  <main class="min-h-screen bg-white text-neutral-900 px-4 md:px-10 pb-24 pt-12">
    <h1 class="mb-8">Indonesia</h1>
    <p class="prose-body text-neutral-600 max-w-3xl">
      Experience the wonders of Indonesia — tropical islands, temples, and vibrant culture.
    </p>
  </main>
  <Footer />
</Layout>
