---
import PageShell from '@/components/layout/PageShell.astro';
import PageBreadcrumbHero from '@/components/sections/PageBreadcrumbHero.astro';
import DestinationCard from '@/components/destinations/DestinationCard.astro';
import LinedHeading from '@/components/ui/LinedHeading.astro';
import { destinations } from '@/domains/destinations/catalog';
import { getResponsiveHero, heroImageSizes } from '@/lib/images';
import { pageUrl } from '@/lib/site';
import heroImg from '@/assets/heroes/shared196.webp';

const hero = await getResponsiveHero(heroImg);

// Bali's region is "Indonesia", so it joins the Asia section here.
const continentOf = (region: string) => (region === 'Indonesia' ? 'Asia' : region);
const continents = ['Europe', 'Asia'].map((name) => ({
  name,
  destinations: destinations.filter((destination) => continentOf(destination.region) === name),
}));
---

<PageShell
  title="Destinations — Voyaflair"
  description="Explore travel guides and notes from Bali, Belgium, France, Greece, Japan, and beyond."
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={hero.src}
      imagesrcset={hero.srcSet}
      imagesizes={heroImageSizes}
      fetchpriority="high"
    />
  </Fragment>

  <PageBreadcrumbHero
    title="Destinations"
    currentPage="Destinations"
    currentHref={pageUrl('destinations')}
    imageSrc={hero.src}
    desktopImageSrc={hero.largeSrc}
    imageSrcSet={hero.srcSet}
    imageSizes={hero.sizes}
    imageAlt="Travel destinations around the world — Voyaflair"
  />

  <main class="relative z-10 bg-white text-neutral-900">
    <div class="flex flex-col gap-8 pb-16 pt-8 md:gap-8 md:pb-16 md:pt-10 lg:gap-12 lg:pb-24 lg:pt-12 xl:gap-16 xl:pt-16">
      <section>
        <div class="section-gutter">
          <LinedHeading title="All Destinations" class="mb-10 md:mb-16" />

          <div class="flex flex-col gap-12 md:gap-16">
            {
              continents.map((continent) => (
                <div class="flex flex-col gap-6 md:gap-8">
                  <h3>{continent.name}</h3>
                  <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-[repeat(auto-fill,317px)]">
                    {continent.destinations.map((destination) => (
                      <DestinationCard destination={destination} />
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </div>
  </main>
</PageShell>
