---
import PageShell from '@/components/layout/PageShell.astro';
import PageBreadcrumbHero from '@/components/sections/PageBreadcrumbHero.astro';
import CtaLink from '@/components/ui/CtaLink.astro';
import { destinations, destinationHref } from '@/domains/destinations/catalog';
import { getResponsiveHero, heroImageSizes, cardImageQuality, cardImageWidths } from '@/lib/images';
import { pageUrl } from '@/lib/site';
import { Image } from 'astro:assets';
import heroImg from '@/assets/heroes/shared196.webp';

const hero = await getResponsiveHero(heroImg);
---

<PageShell
  title="Destinations — Voyaflair"
  description="Explore travel guides and notes from Bali, Belgium, Greece, Japan, and beyond."
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={hero.src}
      imagesrcset={hero.srcSet}
      imagesizes={heroImageSizes}
      fetchpriority="high"
    />
  </Fragment>

  <PageBreadcrumbHero
    title="Destinations"
    currentPage="Destinations"
    currentHref={pageUrl('destinations')}
    imageSrc={hero.src}
    desktopImageSrc={hero.largeSrc}
    imageSrcSet={hero.srcSet}
    imageSizes={hero.sizes}
  />

  <main class="relative z-10 w-full min-h-screen flex flex-col items-center bg-white py-10">
    <p class="meta text-neutral-500 mb-4">Places worth knowing</p>
    <h2 class="text-center md:mb-16 mb-10">Explore</h2>

    <div class="w-full max-w-[1300px] px-4 md:px-[2rem] xl:px-[6rem] flex flex-col gap-10">
      {
        destinations.map((destination) => (
          <article class="flex flex-col sm:flex-row gap-6 pb-10 border-b border-neutral-200 last:border-b-0">
            <div class="w-full sm:w-2/5 lg:w-1/3 aspect-square overflow-hidden rounded-xl">
              <Image
                src={destination.heroImage}
                alt={destination.name}
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
                decoding="async"
                widths={[...cardImageWidths]}
                quality={cardImageQuality}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 40vw, 100vw"
              />
            </div>
            <div class="w-full sm:w-3/5 lg:w-2/3 flex flex-col justify-center gap-4">
              <h3>
                <a href={destinationHref(destination.slug)} class="hover:text-neutral-600 transition-colors">{destination.name}</a>
              </h3>
              <p class="prose-body text-neutral-500">{destination.description}</p>
              <CtaLink href={destinationHref(destination.slug)} label="Explore More" />
            </div>
          </article>
        ))
      }
    </div>
  </main>
</PageShell>
