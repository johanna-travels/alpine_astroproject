---
import type { ImageMetadata } from "astro";

import Layout from "@/layouts/Layout.astro";
import PageNav from "@/components/layout/PageNav.astro";
import heroImage from "@/assets/heroes/services-img.webp";
import galleryImageA from "@/assets/heroes/services-vertical.webp";
import galleryImageB from "@/assets/marketing/services-4x3.webp";
import mundukSERVISESmoding from "@/assets/mundukSERVISESmoding-.webp";
import rhodesanthonyServicesquinnbay from "@/assets/rhodesanthonyServicesquinn-bay copy.webp";
import tokyoJapancopy from "@/assets/tokyojapancopy.webp";
import TheUdayaResort from "@/assets/TheUdayaResort.webp";
import BeachBaliFoto from "@/assets/BeachBaliFoto.webp";
import { Image } from "astro:assets";
import ContactSectionWithShader from "@/components/sections/contact-section-with-shader.tsx";
import Footer from "@/components/layout/Footer.astro";

interface GalleryImage {
  src: ImageMetadata | string;
  alt: string;
}

const galleryImages: [GalleryImage, GalleryImage] = [
  { src: galleryImageA, alt: "Vertical services photography" },
  { src: galleryImageB, alt: "Travel brand visual content" },
];

const galleryTone: "white" | "light" = "white";

const galleryToneClass =
  (galleryTone as "white" | "light") === "light" ? "bg-[#f8f4e7]" : "bg-white";

const gallerySrcOf = (image: GalleryImage) =>
  typeof image.src === "string" ? image.src : image.src.src;

const galleryDimsOf = (image: GalleryImage) =>
  typeof image.src === "string"
    ? {}
    : { width: image.src.width, height: image.src.height };
---

<Layout
  title="Services — Voyaflair"
  description="Visual storytelling for hotels, tourism boards, and travel brands — photography, video, and social content by Voyaflair.">
  <header class="relative min-h-[100vh] w-full">
    <PageNav overlay={true} />

    <div class="fixed inset-0 pointer-events-none z-0">
      <Image
        src={heroImage}
        alt="Hero Background"
        class="h-full w-full hero-img object-center object-cover"
        loading="eager"
        fetchpriority="high"
        format="webp"
        sizes="100vw"
      />
    </div>

    <div class="absolute bg-gray-900/70 inset-0 pointer-events-none z-[1]">
    </div>

    <div
      class="flex flex-col relative items-center justify-center min-h-[100vh] p-6 sm:pb-12 sm:pt-24 sm:px-4 text-center pointer-events-none z-20">
      <h1
        class="text-4xl text-white lg:leading-[1] lg:text-[6.625rem] sm:text-7xl hero-title">
        Work With Me
      </h1>
      <p
        class="max-w-2xl mt-4 text-white lg:leading-[1.1] lg:text-[1.8rem] sm:text-2xl">
        Voyaflair partners with hotels, tourism boards, travel brands, and
        hospitality businesses to create thoughtful visual content that captures
        the character of a destination.
      </p>
    </div>
  </header>

  <main class="relative text-neutral-900 overflow-x-hidden z-10">
    <section
      class="relative w-full lg:min-h-[1000px] bg-transparent overflow-hidden">
      <div class="absolute bg-gray-900/70 inset-0 pointer-events-none z-[1]">
      </div>
      <div class="relative pb-[80vh] pt-[20vh] px-6 z-10">
        <p
          class="max-w-3xl mx-auto text-center text-lg text-white lg:text-[1.8rem]">
          &rdquo;With a focus on atmosphere, design and storytelling, I bring
          attention to the details and elements that make a place stand out —
          from boutique hotels and unique stays to immersive travel experiences
          and local stories.
        </p>
        <p
          class="max-w-3xl mt-6 mx-auto text-center text-lg text-white lg:text-[1.8rem]">
          Through photography, video and editorial-style content, I help brands
          connect with travelers through imagery that feels genuine, engaging
          and true to the experience.&rdquo;
        </p>
      </div>
    </section>

    <section
      class="block relative min-h-0 w-full md:min-h-[400px] pb-10 pt-6 px-6 md:py-16 bg-[#f5f5f5] overflow-hidden z-[1]">
      <!-- Content Wrapper: relative, so it paints above the backdrop -->
      <div class="relative max-w-full w-full mx-auto">
        <div
          class="md:h-[600px] md:w-[800px] md:pl-6 col col-lg-8 col-md-11 col-sm-12">
          <p
            class="min-h-0 w-full md:h-[300px] md:min-h-0 md:w-[700px] pb-8 md:pb-0 leading-[1.2] text-2xl lg:text-5xl sm:text-4xl -indent-2 uppercase">
            Authentic storytelling across Instagram, TikTok, and other digital
            platforms through thoughtfully curated photography, reels, stories
            and more.
          </p>
        </div>

        <div class="justify-end row">
          <div class="col col-lg-8 col-md-10 col-sm-12">
            <!-- Text Row (Brother) -->
            <div class="row">
              <!-- Image Row. -mt-[140px] = 20% of the 700px image, pulling it up
                 into the beige. Percentage margins resolve against width, so px. -->
              <div class="relative mt-0 z-10 md:-mt-[140px]">
                <!-- Colour split, anchored to the image itself: the line falls
                   300px down the 1000px image, so 30% sits on beige and 70% on
                   white. Full-bleed sideways; the tail is clipped by the section. -->
                <div
                  aria-hidden="true"
                  class="absolute h-[9999px] w-screen bg-white -translate-x-1/2 -z-10 left-1/2 top-[40%] md:top-[300px]">
                </div>

                <!-- Image box, straddling the split. Desktop stays 900x1000. -->
                <div
                  class="flex flex-col relative items-center justify-center max-w-full w-full md:h-[1000px] md:min-h-[700px] md:w-[900px] text-center bg-transparent rounded-2xl aspect-[2/3] img-wrapper md:aspect-auto">
                  <img
                    class="relative h-full w-full rounded-lg img img-mobile object-cover z-10"
                    src={TheUdayaResort.src}
                    alt="The Udaya Resort"
                    width={TheUdayaResort.width}
                    height={TheUdayaResort.height}
                    loading="eager"
                    fetchpriority="high"
                  />
                </div>
              </div>

              <div
                class="flex flex-col relative items-start justify-center h-auto w-full md:h-[400px] gap-4 px-0 py-8 lg:pl-12 md:p-6 md:pl-0 text-black img-mobile z-20">
                <h3 class="text-black text-xl lg:text-2xl">Content Creation</h3>
                <p
                  class="lg:w-[800px] md:pb-6 md:pl-0 text-black prose-body"
                  data-scale-from="0.6">
                  Professional photography and video content created for hotels,
                  travel brands, and tourism campaigns. Crafted to elevate your
                  visual presence across websites, social media, marketing
                  materials, and digital platforms.
                </p>
              </div>
            </div>
          </div>

          <!-- Typography -->
        </div>
      </div>

      <section
        class:list={[
          "gallery-section mx-auto mt-6 max-w-6xl border-t-0 px-0 pt-4 pb-0 sm:mt-6 md:mx-8 md:mt-8 md:h-auto md:min-h-[700px] md:px-4 md:pt-2 md:pb-8",
          galleryToneClass,
        ]}>
        <div class="grid min-w-0 gap-4 sm:gap-6 grid-cols-1 sm:grid-cols-2">
          {
            galleryImages.map((image) => (
              <div class="flex flex-col relative items-center justify-center max-w-full min-h-[260px] min-w-0 w-full md:w-[500px] sm:min-h-0 bg-transparent aspect-[4/3] gallery-img-wrapper overflow-hidden sm:aspect-[3/4]">
                <img
                  class="relative h-full max-w-full w-full rounded-lg gallery-img object-cover z-10"
                  src={gallerySrcOf(image)}
                  alt={image.alt}
                  {...galleryDimsOf(image)}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))
          }
        </div>
      </section>
    </section>

    <!-- Frames: text 240 + 3×400 + gap1 35.2 + 2×70.4 + pt56 + pb48 → H 1720 -->
    <section
      class="min-h-[200px] h-auto pb-12 pt-10 px-4 md:pt-14 bg-white z-[2]">
      <div
        class="flex flex-col relative items-start justify-center h-auto w-full md:h-[400px] gap-4 px-0 py-6 lg:pl-12 md:p-6 md:pl-0 text-black z-20">
        <h3 class="text-black text-xl lg:text-2xl">
          Social Media Collaboration
        </h3>
        <p
          class="md:w-[750px] md:pb-6 md:pl-0 prose-body"
          data-scale-from="0.6">
          Authentic promotion across Instagram, TikTok, and other digital
          platforms through carefully curated content, including reels, stories,
          and posts that introduce your property, experience or destination to
          an engaged travel audience.
        </p>
      </div>

      <div class="max-w-6xl mt-8 mx-auto md:mt-[35.2px]">
        <!-- Left-aligned, so the frame sits against the column's start edge. -->
        <div
          class="max-w-full w-full md:h-[400px] md:w-[600px] aspect-[3/2] md:aspect-auto">
          <img
            class="h-full w-full rounded-lg img-mobile object-cover"
            data-scale-from="0.6"
            src={BeachBaliFoto.src}
            alt="Destination atmosphere photography"
            width={BeachBaliFoto.width}
            height={BeachBaliFoto.height}
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- Centred in the column. -->
        <div
          class="max-w-[280px] w-full md:h-[400px] md:max-w-none md:w-[300px] mt-10 mx-auto md:mt-[70.4px] aspect-[3/4] md:aspect-auto">
          <img
            class="h-full w-full rounded-lg img-mobile object-cover"
            data-scale-from="0.6"
            src={tokyoJapancopy.src}
            alt="Destination atmosphere photography"
            width={tokyoJapancopy.width}
            height={tokyoJapancopy.height}
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- Right-aligned; reuses heroImage already imported in this file. -->
        <div
          class="max-w-full w-full md:h-[400px] md:w-[600px] ml-0 mt-10 md:ml-auto md:mt-[70.4px] aspect-[3/2] md:aspect-auto">
          <img
            class="h-full w-full rounded-lg img-mobile object-cover"
            data-scale-from="0.6"
            src={rhodesanthonyServicesquinnbay.src}
            alt="Destination atmosphere photography"
            width={rhodesanthonyServicesquinnbay.width}
            height={rhodesanthonyServicesquinnbay.height}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- Contact: text 380 + img 438.4 + pb 60 → H 878.4 -->
    <section class="px-4 bg-[#f5f5f5] box-border contact-section">
      <div
        class="flex flex-col items-center h-full max-w-6xl gap-10 mx-auto py-20">
        <div class="md:w-[648px] md:pr-4">
          <p class="text-center md:text-2xl" data-scale-from="0.6">
            Every destination has a story to tell. If you’re looking to showcase
            yours through thoughtful imagery and authentic storytelling, I’d
            love to hear from you.
          </p>
        </div>

        <div
          class="flex flex-col relative items-center justify-center max-w-[900px] w-full mt-0 text-center bg-transparent rounded-2xl img-wrapper">
          <img
            class="relative h-full w-full rounded-lg img-mobile object-cover z-10"
            src={mundukSERVISESmoding.src}
            alt="Beach in Bali"
            width={mundukSERVISESmoding.width}
            height={mundukSERVISESmoding.height}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>
    <ContactSectionWithShader client:idle showImage={false} stacked />
    <Footer />
  </main>

  <!-- JAVASCRIPT FOR GSAP ANIMATIONS -->

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { SplitText } from "gsap/SplitText";

    gsap.registerPlugin(ScrollTrigger, SplitText);

    document.fonts?.ready.then(() => ScrollTrigger.refresh());

    const galleryScale = gsap.matchMedia();
    galleryScale.add("(min-width: 768px)", () => {
      (gsap.utils.toArray(".gallery-img") as HTMLElement[]).forEach((image) => {
        gsap.fromTo(
          image,
          {
            scale: 0.6,
            transformOrigin: "top center",
          },
          {
            scale: 1,
            ease: "none",
            scrollTrigger: {
              trigger: image.parentElement,
              start: "top bottom",
              end: "center center",
              scrub: 1,
              markers: false,
            },
          },
        );
      });
    });

    // mobile-below(768px)

    galleryScale.add("(max-width: 767px)", () => {
      (gsap.utils.toArray(".gallery-img") as HTMLElement[]).forEach((image) => {
        gsap.fromTo(
          image,
          {
            scale: 0.8, // Less dramatic scale for mobile
            transformOrigin: "center center",
          },
          {
            scale: 1,
            ease: "none",
            scrollTrigger: {
              trigger: image.parentElement,
              start: "top 85%", // Adjusted for mobile viewport
              end: "center 60%",
              scrub: true,
            },
          },
        );
      });
    });

    galleryScale.add("(max-width: 767px)", () => {
      (gsap.utils.toArray(".img-mobile") as HTMLElement[]).forEach((image) => {
        const fromScale = Number(image.dataset.scaleFrom) || 0.8;

        gsap.fromTo(
          image,
          {
            scale: fromScale,
            transformOrigin: "center center",
          },
          {
            scale: 1,
            ease: "none",
            scrollTrigger: {
              trigger: image.parentElement,
              start: "top 85%",
              end: "center 60%",
              scrub: true,
            },
          },
        );
      });
    });

    galleryScale.add("(min-width: 768px)", () => {
      (gsap.utils.toArray("[data-scale-from]") as HTMLElement[]).forEach(
        (image) => {
          const fromScale = Number(image.dataset.scaleFrom) || 0.6;

          gsap.fromTo(
            image,
            {
              scale: fromScale,
              transformOrigin: "top center",
            },
            {
              scale: 1,
              ease: "none",
              scrollTrigger: {
                trigger: image.parentElement,
                start: "top bottom",
                end: "center center",
                scrub: 1,
                markers: false,
              },
            },
          );
        },
      );

      (gsap.utils.toArray(".img") as HTMLElement[]).forEach((image) => {
        gsap.fromTo(
          image,
          {
            scale: 0.6,
          },
          {
            scale: 1,
            ease: "none",
            scrollTrigger: {
              trigger: image.parentElement,
              start: "top bottom",
              end: "center center",
              scrub: 1,
              markers: false,
            },
          },
        );
      });
    });

    (gsap.utils.toArray(".reveal-section") as Element[]).forEach((section) => {
      const children = section.querySelectorAll("article *");

      if (children.length > 0) {
        gsap.from(children, {
          opacity: 0,
          y: 30,
          duration: 1,
          ease: "power2.out",
          stagger: 0.2,
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            toggleActions: "play none none none",
          },
        });
      }
    });
  </script>
</Layout>
