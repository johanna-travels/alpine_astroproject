---
import PageShell from '@/components/layout/PageShell.astro';
import DestinationHub from '@/components/destinations/DestinationHub.astro';
import { destinations } from '@/domains/destinations/catalog';

export function getStaticPaths() {
  return destinations.map((destination) => ({
    params: { destination: destination.slug },
    props: { destination },
  }));
}

const { destination } = Astro.props;
---

<PageShell title={destination.seoTitle} description={destination.seoDescription}>
  <DestinationHub destination={destination} />
</PageShell>
