---
import PageShell from '@/components/layout/PageShell.astro';
import DestinationHub from '@/components/destinations/DestinationHub.astro';
import { destinations } from '@/domains/destinations/catalog';
import { getSocialShareImage } from '@/lib/images';

export function getStaticPaths() {
  return destinations.map((destination) => ({
    params: { destination: destination.slug },
    props: { destination },
  }));
}

const { destination } = Astro.props;
const shareImage = await getSocialShareImage(destination.heroImage);
---

<PageShell
  title={destination.seoTitle}
  description={destination.seoDescription}
  image={shareImage.src}
  imageAlt={`${destination.name} — Voyaflair`}
  imageWidth={shareImage.width}
  imageHeight={shareImage.height}
>
  <DestinationHub destination={destination} />
</PageShell>
